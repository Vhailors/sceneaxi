{
  "name": "@sceneaxi/desktop-windows",
  "version": "0.0.0",
  "private": true,
  "description": "SceneAxi Engine Desktop — signed Windows NSIS packaging around the existing desktop application",
  "homepage": "https://github.com/Vhailors/sceneaxi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vhailors/sceneaxi.git"
  },
  "type": "module",
  "main": "dist/main.cjs",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron dist/main.cjs",
    "dist": "node scripts/dist.mjs",
    "draft:upload": "node scripts/release.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "sceneaxi": {
    "releaseGroup": "desktop"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "~5.9.3"
  }
}
