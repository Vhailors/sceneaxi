{
  "name": "@sceneaxi/desktop-macos",
  "version": "0.0.0",
  "private": true,
  "description": "macOS packaging for the existing SceneAxi Engine Desktop application",
  "homepage": "https://github.com/Vhailors/sceneaxi",
  "author": "SceneAxi",
  "type": "module",
  "main": "dist/main.cjs",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dist": "node scripts/dist.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sceneaxi/schemas": "link:../../packages/schemas",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "~5.9.3"
  },
  "sceneaxi": {
    "releaseGroup": "desktop"
  },
  "license": "UNLICENSED",
  "pnpm": {
    "overrides": {
      "js-yaml@4": "4.3.2",
      "fast-uri@3": "3.1.8",
      "brace-expansion@5": "5.0.12",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@1": "1.1.21",
      "postcss@8": "8.5.23",
      "nanoid@3": "3.3.18"
    }
  }
}
