{
  "name": "@sceneaxi/desktop-linux",
  "version": "0.0.0",
  "private": true,
  "description": "SceneAxi Engine Desktop — packaged Linux application (Electron) over the desktop-shell visual model and the real engine stack",
  "homepage": "https://github.com/Vhailors/sceneaxi",
  "author": "SceneAxi",
  "type": "module",
  "main": "dist/main.cjs",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron dist/main.cjs",
    "dist": "node scripts/dist.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sceneaxi/authoring-core": "link:../../packages/authoring-core",
    "@sceneaxi/desktop-shell": "link:../../apps/desktop-shell",
    "@sceneaxi/engine-kernel": "link:../../packages/engine-kernel",
    "@sceneaxi/engine-orchestrator": "link:../../packages/engine-orchestrator",
    "@sceneaxi/engine-presentation": "link:../../packages/engine-presentation",
    "@sceneaxi/schemas": "link:../../packages/schemas",
    "@sceneaxi/site-kit": "link:../../packages/site-kit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "~5.9.3"
  },
  "sceneaxi": { "releaseGroup": "desktop" },
  "license": "UNLICENSED"
}
