{
  "name": "@sceneaxi/desktop-linux",
  "version": "0.0.0",
  "private": true,
  "description": "SceneAxi Engine Desktop \u2014 packaged Linux application (Electron) over the desktop-shell visual model and the real engine stack",
  "homepage": "https://github.com/Vhailors/sceneaxi",
  "author": "SceneAxi",
  "type": "module",
  "main": "dist/main.cjs",
  "exports": {
    ".": "./src/index.ts",
    "./electron/provider-runtime": "./src/electron/provider-runtime.ts"
  },
  "scripts": {
    "build": "node scripts/build-linux.mjs",
    "check:renderer": "node scripts/check-renderer.mjs",
    "start": "electron dist/main.cjs",
    "dist": "node scripts/dist.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sceneaxi/authoring-core": "link:../../packages/authoring-core",
    "@sceneaxi/desktop-shell": "link:../../apps/desktop-shell",
    "@sceneaxi/engine-kernel": "link:../../packages/engine-kernel",
    "@sceneaxi/engine-orchestrator": "link:../../packages/engine-orchestrator",
    "@sceneaxi/engine-presentation": "link:../../packages/engine-presentation",
    "@sceneaxi/importers": "link:../../packages/importers",
    "@sceneaxi/physics-rapier": "link:../../packages/physics-rapier",
    "@sceneaxi/provider-openrouter": "link:../../packages/provider-openrouter",
    "@sceneaxi/schemas": "link:../../packages/schemas",
    "@sceneaxi/site-kit": "link:../../packages/site-kit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "~5.9.3"
  },
  "sceneaxi": {
    "releaseGroup": "desktop"
  },
  "license": "UNLICENSED",
  "pnpm": {
    "overrides": {
      "fast-uri@3": "3.1.8",
      "brace-expansion@5": "5.0.12",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@1": "1.1.21",
      "postcss@8": "8.5.23",
      "nanoid@3": "3.3.18"
    }
  }
}
