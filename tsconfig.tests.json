{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@sceneaxi/site-kit": [
        "./packages/site-kit/src/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "tests",
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "sites/*/src/index.ts",
    "sites/*/src/lib/**/*.ts"
  ]
}
