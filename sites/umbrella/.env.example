# Names only. Never commit a value. See docs/websites-deploy.md for the owner of
# each variable and how to set it in the Vercel project.

# One shared Neon Postgres database for the identity plane and catalog read models.
DATABASE_URL=
# Better Auth deployment origin; credentials remain with that provider.
BETTER_AUTH_ORIGIN=

# Sole admin identity, resolved by @sceneaxi/auth on this site. The only source of
# the admin role, and it grants nothing until a session is verified for real.
SCENEAXI_ADMIN_EMAIL=
# First-run admin credential material. Env-secret bootstrap only.
SCENEAXI_ADMIN_BOOTSTRAP_SECRET=

# Stripe TEST keys only. Live mode needs a separate captain decision.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "test" by default; "live" refuses without explicit live authorization.
SCENEAXI_BILLING_MODE=

# This site's own canonical https origin. The only source of the checkout success
# and cancel URLs, which are never derived from the request's Host.
NEXT_PUBLIC_SCENEAXI_UMBRELLA_ORIGIN=

# Family cross-links, https *.vercel.app origins.
NEXT_PUBLIC_SCENEAXI_GAME_CATALOG_ORIGIN=
NEXT_PUBLIC_SCENEAXI_WEB_CATALOG_ORIGIN=

# Set to 1 to grant a banner-marked editor preview while no member can hold a
# session, so no real entitlement can be resolved. Absent means the editor
# refuses. Server-side only; a client value is ignored.
SCENEAXI_SITE_EDITOR_PREVIEW=
