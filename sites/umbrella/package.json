{
  "name": "@sceneaxi/site-umbrella",
  "version": "0.0.0",
  "private": true,
  "description": "SceneAxi umbrella site \u2014 product/docs, the public live open path, engine SDK download, account surface, credit packs, entitled Minimum E2 web editor",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node ../../scripts/check-vercel-package.mjs .",
    "start": "next start",
    "test:provider": "vitest run --config vitest.config.ts",
    "test:visual": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build:sdk": "node ../../scripts/build-engine-sdk.mjs --out public/engine-sdk",
    "prebuild": "pnpm run build:sdk",
    "predev": "pnpm run build:sdk"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sceneaxi/auth": "link:../../packages/auth",
    "@sceneaxi/billing": "link:../../packages/billing",
    "@sceneaxi/engine-presentation": "link:../../packages/engine-presentation",
    "@sceneaxi/site-kit": "link:../../packages/site-kit",
    "better-auth": "^1.6.26",
    "next": "15.5.21",
    "pg": "^8.22.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.4",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "sceneaxi": {
    "releaseGroup": "sites"
  },
  "license": "UNLICENSED"
}
