# Authoritative linker source for this deployable install root. `nodeLinker` in
# pnpm-workspace.yaml is only read by pnpm >= 10.6, and neither this site nor Vercel
# pins a package manager, so the setting has to live where every supported pnpm reads
# it. Without it the isolated symlink graph returns and Vercel refuses the function.
node-linker=hoisted
