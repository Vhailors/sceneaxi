# Names only. Never commit a value. See docs/websites-deploy.md.

# One shared Neon Postgres database (catalog read models).
DATABASE_URL=

# Deep-link target for the umbrella editor. Must be an https *.vercel.app origin;
# the site refuses to render the link rather than emit a broken one.
NEXT_PUBLIC_SCENEAXI_UMBRELLA_ORIGIN=

# Family cross-links, https *.vercel.app origins. The family bar links whichever of
# these is set, marks this store as current, and renders an unset sibling as plain
# text rather than a broken link. The entry matching this surface is also where the
# storefront's own domain line comes from, so an unset value prints no domain.
NEXT_PUBLIC_SCENEAXI_GAME_CATALOG_ORIGIN=
NEXT_PUBLIC_SCENEAXI_WEB_CATALOG_ORIGIN=
