+
+/* SAFETY: post-PR interaction paint only; disabled controls stay visibly inert. */
+.edshell [data-kind]:hover:not(.is-inert):not(:disabled):not([aria-disabled="true"]) {
+  background: var(--bg-control);
+}
+
+.edshell [data-kind]:active:not(.is-inert):not(:disabled):not([aria-disabled="true"]) {
+  box-shadow: inset 0 -2px 0 var(--accent);
+}
+
+.edshell :is(button, a) svg {
+  flex-shrink: 0;
+  vertical-align: middle;
+}
+
+.ed-local-project-panel {
+  max-height: min(480px, calc(100dvh - 80px));
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+
+.ed-local-project-panel button {
+  overflow-wrap: anywhere;
+  border: 1px solid var(--line);
+  border-radius: var(--radius-md);
+}
+
+.ed-local-project-panel button:disabled {
+  color: var(--fg-2);
+  background: var(--bg-raised);
+  cursor: not-allowed;
+}
+
