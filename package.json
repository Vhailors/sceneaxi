{
  "name": "sceneaxi",
  "private": true,
  "version": "0.0.0",
  "description": "SceneAxi monorepo — agent-native interactive engine/library ecosystem",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsc --build && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "gate": "pnpm -s check:syntax && pnpm -s check:boundaries && pnpm -s build && pnpm -s test && pnpm -s lint"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
