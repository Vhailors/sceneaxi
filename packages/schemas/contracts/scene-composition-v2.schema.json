{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/scene-composition/v2",
  "title": "SceneAxi Scene Composition v2",
  "description": "Explicit opt-in XYZ intrinsic Euler TRS local placements and column-major parent*child affine world matrices (including shear). V1 is unchanged. Runtime recomputes all poses, depth/order, conservative rest-pose bounds and digests; scale stretches remain 1e-6..9007199254, count32/depth8 unchanged. No artifact rewriting.",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "boundedNumber": {
      "type": "number",
      "minimum": -9007199254,
      "maximum": 9007199254
    },
    "boundedPositiveNumber": {
      "type": "number",
      "minimum": 1e-06,
      "maximum": 9007199254
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "$ref": "#/$defs/boundedNumber"
        }
      ],
      "items": false
    },
    "positiveVector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/boundedPositiveNumber"
        },
        {
          "$ref": "#/$defs/boundedPositiveNumber"
        },
        {
          "$ref": "#/$defs/boundedPositiveNumber"
        }
      ],
      "items": false
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotationEulerDegrees",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/$defs/vector3"
        },
        "rotationEulerDegrees": {
          "$ref": "#/$defs/vector3"
        },
        "scale": {
          "$ref": "#/$defs/positiveVector3"
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "artifactId",
        "parentInstanceId",
        "transform"
      ],
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "artifactId": {
          "$ref": "#/$defs/identifier",
          "description": "Reuse across placements is legal instancing."
        },
        "parentInstanceId": {
          "description": "Exactly one placement declares null, and it must be rootInstanceId.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        },
        "transform": {
          "$ref": "#/$defs/transform"
        }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "sceneId",
        "rootInstanceId",
        "placements"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "sceneaxi.scene-composition-intake"
        },
        "sceneId": {
          "$ref": "#/$defs/identifier"
        },
        "rootInstanceId": {
          "$ref": "#/$defs/identifier"
        },
        "placements": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/placement"
          }
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "artifactId",
        "parentInstanceId",
        "depth",
        "localTransform",
        "worldMatrix",
        "artifact",
        "bounds"
      ],
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/identifier"
        },
        "artifactId": {
          "$ref": "#/$defs/identifier"
        },
        "parentInstanceId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "localTransform": {
          "$ref": "#/$defs/transform"
        },
        "artifact": {
          "$ref": "https://sceneaxi.invalid/contracts/sculpt-artifact/v1",
          "description": "A complete Sculpt Artifact as defined by sculpt-artifact.schema.json, embedded unmodified so its own evidence digests stay verifiable."
        },
        "worldMatrix": {
          "$ref": "#/$defs/worldMatrix"
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intakeDigest",
        "placementDigest",
        "artifactDigests",
        "sceneDigest"
      ],
      "properties": {
        "intakeDigest": {
          "$ref": "#/$defs/digest"
        },
        "placementDigest": {
          "$ref": "#/$defs/digest"
        },
        "artifactDigests": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "artifactDigest"
            ],
            "properties": {
              "instanceId": {
                "$ref": "#/$defs/identifier"
              },
              "artifactDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "sceneDigest": {
          "$ref": "#/$defs/digest",
          "description": "Canonical digest of the ComposedScene with evidence.sceneDigest omitted, so it is independently recomputable and tamper-evident."
        }
      }
    },
    "composedScene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "sceneId",
        "rootInstanceId",
        "instances",
        "evidence"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "const": "sceneaxi.composed-scene"
        },
        "sceneId": {
          "$ref": "#/$defs/identifier"
        },
        "rootInstanceId": {
          "$ref": "#/$defs/identifier"
        },
        "instances": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "description": "Ordered by ascending depth, then ascending instanceId.",
          "items": {
            "$ref": "#/$defs/instance"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "worldMatrix": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "prefixItems": [
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "const": 0
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "const": 0
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "const": 0
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "$ref": "#/$defs/boundedNumber"
        },
        {
          "const": 1
        }
      ],
      "items": false
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/vector3"
        },
        "max": {
          "$ref": "#/$defs/vector3"
        }
      },
      "description": "Rest-pose conservative AABB matches existing primitive geometry: sphere radius max dimension/2, cylinder radial extent max x,z/2; includes every node composed through artifact parentage. Not an animated bound."
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/intake"
    },
    {
      "$ref": "#/$defs/composedScene"
    }
  ]
}
