{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/billing-checkout/v1",
  "title": "SceneAxi billing checkout records (v1)",
  "description": "StripeCustomerLink, CheckoutSessionIntent, and the normalized CheckoutCompletedEvent. The intent is provider-neutral and secret-free: it describes the checkout SceneAxi wants created, not a provider API call, so it is safe to log, persist, and hand to an injected adapter. mode defaults to test everywhere; reaching live requires an explicit captain go-live decision (docs/auth-credits.md).",
  "oneOf": [
    { "$ref": "#/$defs/stripeCustomerLink" },
    { "$ref": "#/$defs/checkoutSessionIntent" },
    { "$ref": "#/$defs/checkoutCompletedEvent" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "Opaque server-issued identifier: url-safe, 1-128 characters."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Lowercase slug: a credit pack id or a catalog listing id, per purpose."
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 date-time with an explicit timezone. Timezone-less values refuse."
    },
    "mode": {
      "type": "string",
      "enum": ["test", "live"],
      "description": "Billing mode. test is the default everywhere; live is never implicit."
    },
    "purpose": {
      "type": "string",
      "enum": ["credit-pack", "catalog-listing"],
      "description": "What a checkout is for. The two purposes settle differently, so the purpose is part of the contract rather than inferred from which optional field is present."
    },
    "redirectUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Absolute https URL. A checkout redirect carries a post-payment state transition, so plaintext http refuses rather than being upgraded."
    },
    "currency": {
      "type": "string",
      "pattern": "^[a-z]{3}$",
      "description": "Lowercase three-letter ISO 4217 code."
    },
    "stripeCustomerLink": {
      "type": "object",
      "title": "StripeCustomerLink",
      "description": "Links a SceneAxi user to a provider customer, per mode. Test-mode and live-mode links are distinct records.",
      "required": [
        "schemaVersion",
        "kind",
        "userId",
        "stripeCustomerId",
        "mode",
        "linkedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.stripe-customer-link" },
        "userId": { "$ref": "#/$defs/identifier" },
        "stripeCustomerId": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/mode" },
        "linkedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "checkoutSessionIntent": {
      "type": "object",
      "title": "CheckoutSessionIntent",
      "description": "Provider-neutral, secret-free description of a checkout to create. Carries no API key, signature, or customer-identifying field beyond userId. `credits` is present exactly when purpose is credit-pack; a listing sale grants no credits, so the contract refuses a nominal one.",
      "required": [
        "schemaVersion",
        "kind",
        "intentId",
        "userId",
        "purpose",
        "itemId",
        "unitAmount",
        "currency",
        "stripePriceId",
        "mode",
        "successUrl",
        "cancelUrl",
        "idempotencyKey",
        "createdAt"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.checkout-session-intent" },
        "intentId": { "$ref": "#/$defs/identifier" },
        "userId": { "$ref": "#/$defs/identifier" },
        "purpose": { "$ref": "#/$defs/purpose" },
        "itemId": { "$ref": "#/$defs/slug" },
        "credits": { "type": "integer", "minimum": 1 },
        "unitAmount": { "type": "integer", "minimum": 1 },
        "currency": { "$ref": "#/$defs/currency" },
        "stripePriceId": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/mode" },
        "successUrl": { "$ref": "#/$defs/redirectUrl" },
        "cancelUrl": { "$ref": "#/$defs/redirectUrl" },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "purpose": { "const": "credit-pack" } },
            "required": ["purpose"]
          },
          "then": { "required": ["credits"] }
        },
        {
          "if": {
            "properties": { "purpose": { "const": "catalog-listing" } },
            "required": ["purpose"]
          },
          "then": { "not": { "required": ["credits"] } }
        }
      ]
    },
    "checkoutCompletedEvent": {
      "type": "object",
      "title": "CheckoutCompletedEvent",
      "description": "A provider event normalized to SceneAxi vocabulary before it touches credits. Only reachable after webhook signature verification; the resulting grant is keyed on stripe-event:<eventId> so a replay grants nothing. `checkoutSessionId` is the provider Checkout Session this completion settles, so settlement evidence retrieved for another identically-priced paid session cannot validate it. `credits` is present exactly when purpose is credit-pack.",
      "required": [
        "schemaVersion",
        "kind",
        "eventId",
        "type",
        "mode",
        "checkoutSessionId",
        "intentId",
        "userId",
        "purpose",
        "itemId",
        "unitAmount",
        "currency",
        "stripePriceId",
        "occurredAt"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.checkout-completed-event" },
        "eventId": { "$ref": "#/$defs/identifier" },
        "type": { "const": "checkout.session.completed" },
        "mode": { "$ref": "#/$defs/mode" },
        "checkoutSessionId": { "$ref": "#/$defs/identifier" },
        "intentId": { "$ref": "#/$defs/identifier" },
        "userId": { "$ref": "#/$defs/identifier" },
        "purpose": { "$ref": "#/$defs/purpose" },
        "itemId": { "$ref": "#/$defs/slug" },
        "credits": { "type": "integer", "minimum": 1 },
        "unitAmount": { "type": "integer", "minimum": 1 },
        "currency": { "$ref": "#/$defs/currency" },
        "stripePriceId": { "type": "string", "minLength": 1 },
        "occurredAt": { "$ref": "#/$defs/dateTime" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "purpose": { "const": "credit-pack" } },
            "required": ["purpose"]
          },
          "then": { "required": ["credits"] }
        },
        {
          "if": {
            "properties": { "purpose": { "const": "catalog-listing" } },
            "required": ["purpose"]
          },
          "then": { "not": { "required": ["credits"] } }
        }
      ]
    }
  }
}
