{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/project-manifest/v1",
  "title": "SceneAxi native project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "formatVersion", "projectId", "capabilities", "objects", "assets", "migrations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "sceneaxi.project-manifest" },
    "formatVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": { "major": { "const": 1 }, "minor": { "const": 0 } }
    },
    "projectId": { "$ref": "#/$defs/id" },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {
            "enum": [
              "project.lifecycle", "project.inspect", "project.migrate",
              "authoring.change-review", "authoring.undo", "authoring.redo", "input.actions", "runtime.play",
              "delivery.export-web", "assistant.build.local", "assistant.build.byo",
              "assistant.agent.bounded", "assistant.progress", "assistant.cancel",
              "scene.compose", "asset.contained-gltf"
            ]
          },
          "version": { "const": 1 }
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "sourceId", "capability"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "const": "scene-document" },
          "path": { "const": "scene.json" },
          "sourceId": { "$ref": "#/$defs/id" },
          "capability": { "const": "authoring.change-review" }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceId", "path", "mediaType", "digest", "capability"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "sourceId": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/path" },
          "mediaType": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" },
          "capability": { "const": "asset.contained-gltf" }
        }
      }
    },
    "migrations": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fromVersion", "toVersion", "sourceDigest"],
        "properties": {
          "id": { "const": "legacy-contained-v0-to-native-v1" },
          "fromVersion": { "$ref": "#/$defs/v0" },
          "toVersion": { "$ref": "#/$defs/v1" },
          "sourceDigest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\u0000]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "v0": {
      "type": "object", "additionalProperties": false, "required": ["major", "minor"],
      "properties": { "major": { "const": 0 }, "minor": { "const": 0 } }
    },
    "v1": {
      "type": "object", "additionalProperties": false, "required": ["major", "minor"],
      "properties": { "major": { "const": 1 }, "minor": { "const": 0 } }
    }
  }
}
