{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/catalog-item/v1",
  "title": "SceneAxi Catalog Item (v1)",
  "description": "Versioned Catalog Item contract: Asset Package reference + rights, provenance, mandatory AI-generation disclosure, compatibility (core range \u00d7 profile list), moderation/pipeline state, and inert commerce fields. Policy SoT remains factories-helpers#47 (Asset Package interchange/acceptance/loss ledger) and factories-helpers#48 (untrusted-asset ingestion + supply-chain controls) \u2014 this schema implements types only, does not rewrite those policies. Topology-neutral: this contract does not encode the locked storefront topology owned by sceneaxi#1. Commerce activation is structurally inactive until tier-6b marketplace holds open per storefront.",
  "type": "object",
  "required": [
    "schemaVersion",
    "itemId",
    "assetPackage",
    "rights",
    "provenance",
    "aiGenerationDisclosure",
    "compatibility",
    "moderation",
    "commerce"
  ],
  "additionalProperties": false,
  "$defs": {
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8])))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)(?![\\s\\S])"
    },
    "transitionRecord": {
      "type": "object",
      "required": ["from", "to", "reason", "at"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "enum": ["intake", "screening", "curation", "listed", "delisted"]
        },
        "to": {
          "type": "string",
          "enum": ["intake", "screening", "curation", "listed", "delisted"]
        },
        "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "at": { "$ref": "#/$defs/dateTime" },
        "humanVerdict": {
          "type": "object",
          "description": "Human curation gate representation only \u2014 never simulated by the pipeline.",
          "required": ["kind", "decision", "curatorId", "rationale", "recordedAt"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "human" },
            "decision": { "type": "string", "enum": ["approve", "reject"] },
            "curatorId": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "recordedAt": { "$ref": "#/$defs/dateTime" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "to": { "const": "listed" } },
            "required": ["to"]
          },
          "then": {
            "required": ["humanVerdict"],
            "properties": {
              "humanVerdict": {
                "properties": { "decision": { "const": "approve" } }
              }
            }
          },
          "else": { "not": { "required": ["humanVerdict"] } }
        }
      ]
    },
    "intakeToScreening": {
      "allOf": [
        { "$ref": "#/$defs/transitionRecord" },
        {
          "properties": {
            "from": { "const": "intake" },
            "to": { "const": "screening" }
          }
        }
      ]
    },
    "screeningToCuration": {
      "allOf": [
        { "$ref": "#/$defs/transitionRecord" },
        {
          "properties": {
            "from": { "const": "screening" },
            "to": { "const": "curation" }
          }
        }
      ]
    },
    "curationToListed": {
      "allOf": [
        { "$ref": "#/$defs/transitionRecord" },
        {
          "properties": {
            "from": { "const": "curation" },
            "to": { "const": "listed" }
          }
        }
      ]
    },
    "listedToDelisted": {
      "allOf": [
        { "$ref": "#/$defs/transitionRecord" },
        {
          "properties": {
            "from": { "const": "listed" },
            "to": { "const": "delisted" }
          }
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "itemId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])",
      "description": "Stable catalog item id."
    },
    "assetPackage": {
      "type": "object",
      "description": "Reference to an Asset Package. Canonical/derived/never-canonical classification and acceptance transaction: factories-helpers#47.",
      "required": ["packageId", "contentHash"],
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "rights": {
      "type": "object",
      "required": ["license", "rightsHolder", "commercialUseAllowed"],
      "additionalProperties": false,
      "properties": {
        "license": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "rightsHolder": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "commercialUseAllowed": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Provenance record for intake under untrusted-asset controls (factories-helpers#48).",
      "required": ["origin", "ingestedAt", "sourceDigest"],
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "ingestedAt": { "$ref": "#/$defs/dateTime" },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "aiGenerationDisclosure": {
      "type": "object",
      "description": "Mandatory AI-generation disclosure; listing refuses without it.",
      "required": ["aiGenerated", "disclosureText"],
      "additionalProperties": false,
      "properties": {
        "aiGenerated": { "type": "boolean" },
        "tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "disclosureText": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "compatibility": {
      "type": "object",
      "description": "Compatibility as (core semver range \u00d7 profile id list). Topology- and Kids-neutral: Kids allowlist is not expressed here.",
      "required": ["coreRange", "profiles"],
      "additionalProperties": false,
      "properties": {
        "coreRange": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"
          }
        }
      }
    },
    "moderation": {
      "type": "object",
      "required": ["pipelineState", "history"],
      "additionalProperties": false,
      "properties": {
        "pipelineState": {
          "type": "string",
          "enum": ["intake", "screening", "curation", "listed", "delisted"]
        },
        "history": {
          "type": "array",
          "items": { "$ref": "#/$defs/transitionRecord" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "pipelineState": { "const": "intake" } },
            "required": ["pipelineState"]
          },
          "then": {
            "properties": { "history": { "maxItems": 0 } }
          }
        },
        {
          "if": {
            "properties": { "pipelineState": { "const": "screening" } },
            "required": ["pipelineState"]
          },
          "then": {
            "properties": {
              "history": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{ "$ref": "#/$defs/intakeToScreening" }]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "pipelineState": { "const": "curation" } },
            "required": ["pipelineState"]
          },
          "then": {
            "properties": {
              "history": {
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  { "$ref": "#/$defs/intakeToScreening" },
                  { "$ref": "#/$defs/screeningToCuration" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "pipelineState": { "const": "listed" } },
            "required": ["pipelineState"]
          },
          "then": {
            "properties": {
              "history": {
                "minItems": 3,
                "maxItems": 3,
                "prefixItems": [
                  { "$ref": "#/$defs/intakeToScreening" },
                  { "$ref": "#/$defs/screeningToCuration" },
                  { "$ref": "#/$defs/curationToListed" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "pipelineState": { "const": "delisted" } },
            "required": ["pipelineState"]
          },
          "then": {
            "properties": {
              "history": {
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  { "$ref": "#/$defs/intakeToScreening" },
                  { "$ref": "#/$defs/screeningToCuration" },
                  { "$ref": "#/$defs/curationToListed" },
                  { "$ref": "#/$defs/listedToDelisted" }
                ]
              }
            }
          }
        }
      ]
    },
    "commerce": {
      "type": "object",
      "description": "Commerce fields are present but structurally inert until tier-6b marketplace activation holds open (read per-storefront). No activation path opens in this contract version.",
      "required": ["activation"],
      "additionalProperties": false,
      "properties": {
        "activation": { "const": "inert" },
        "price": {
          "type": "object",
          "required": ["amount", "currency"],
          "additionalProperties": false,
          "properties": {
            "amount": { "type": "string" },
            "currency": { "type": "string" }
          }
        },
        "sku": { "type": "string" }
      }
    }
  }
}
