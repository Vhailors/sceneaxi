{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/sculpt-artifact/v1",
  "title": "SceneAxi Sculpt Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "artifactId", "spec", "proceduralModule", "runtimeHierarchy", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "sceneaxi.sculpt-artifact" },
    "artifactId": { "$ref": "#/$defs/id" },
    "spec": { "$ref": "https://sceneaxi.invalid/contracts/object-sculpt-spec/v1" },
    "proceduralModule": {
      "type": "object", "additionalProperties": false,
      "required": ["moduleId", "exportName", "sourceDigest", "seed", "emitDigest"],
      "properties": {
        "moduleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*$" },
        "exportName": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "seed": { "type": "integer", "minimum": 0 },
        "emitDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "runtimeHierarchy": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "rootNodeId", "nodes", "pivots", "sockets", "colliders", "materials", "attachments"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.animation-ready-hierarchy" },
        "rootNodeId": { "$ref": "#/$defs/id" },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "https://sceneaxi.invalid/contracts/object-sculpt-spec/v1#/$defs/hierarchyNode" } },
        "pivots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pivot" } },
        "sockets": { "type": "array", "minItems": 1, "items": { "$ref": "https://sceneaxi.invalid/contracts/object-sculpt-spec/v1#/$defs/socket" } },
        "colliders": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/collider" } },
        "materials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/materialBinding" } },
        "attachments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attachment" } }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "intakeDigest", "specDigest", "proceduralModuleDigest", "qualityGates"],
      "properties": {
        "method": { "enum": ["image-brief-reconstruction", "structured-fixture"] },
        "intakeDigest": { "$ref": "#/$defs/digest" },
        "specDigest": { "$ref": "#/$defs/digest" },
        "proceduralModuleDigest": { "$ref": "#/$defs/digest" },
        "qualityGates": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "status", "digest"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "status": { "const": "passed" }, "digest": { "$ref": "#/$defs/digest" } }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "positiveVector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "pivot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "nodeId", "origin"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nodeId": { "$ref": "#/$defs/id" },
        "origin": { "$ref": "#/$defs/vector3" }
      }
    },
    "collider": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "nodeId", "shape", "dimensions", "isTrigger"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nodeId": { "$ref": "#/$defs/id" },
        "shape": { "enum": ["box", "cylinder", "sphere"] },
        "dimensions": { "$ref": "#/$defs/positiveVector3" },
        "isTrigger": { "type": "boolean" }
      }
    },
    "materialBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeId", "materialId"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/id" },
        "materialId": { "$ref": "#/$defs/id" }
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "nodeId", "socketId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nodeId": { "$ref": "#/$defs/id" },
        "socketId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
