{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/object-sculpt-spec/v1",
  "title": "SceneAxi ObjectSculptSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "rootNodeId", "components", "materials", "sockets", "hierarchy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "sceneaxi.object-sculpt-spec" },
    "id": { "$ref": "#/$defs/id" },
    "rootNodeId": { "$ref": "#/$defs/id" },
    "complexityClass": { "enum": ["simple", "non-trivial"] },
    "passes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pass" }
    },
    "detailInventory": { "$ref": "#/$defs/detailInventory" },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
    "materials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/material" } },
    "sockets": { "type": "array", "items": { "$ref": "#/$defs/socket" } },
    "hierarchy": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hierarchyNode" } }
  },
  "oneOf": [
    {
      "not": {
        "anyOf": [
          { "required": ["complexityClass"] },
          { "required": ["passes"] },
          { "required": ["detailInventory"] }
        ]
      }
    },
    {
      "required": ["complexityClass", "passes"],
      "properties": {
        "passes": {
          "oneOf": [
            {
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                { "$ref": "#/$defs/blockoutPass" },
                { "$ref": "#/$defs/structurePass" },
                { "$ref": "#/$defs/materialsPass" },
                { "$ref": "#/$defs/socketsPass" }
              ],
              "items": false
            },
            {
              "minItems": 5,
              "maxItems": 5,
              "prefixItems": [
                { "$ref": "#/$defs/blockoutPass" },
                { "$ref": "#/$defs/structurePass" },
                { "$ref": "#/$defs/materialsPass" },
                { "$ref": "#/$defs/surfaceDetailPass" },
                { "$ref": "#/$defs/socketsPass" }
              ],
              "items": false
            }
          ]
        },
        "sockets": {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "attachment" } }
          },
          "minContains": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["complexityClass"],
            "properties": { "complexityClass": { "const": "non-trivial" } }
          },
          "then": {
            "required": ["detailInventory"],
            "properties": {
              "components": { "minItems": 3 },
              "materials": { "minItems": 2 },
              "hierarchy": { "minItems": 3 },
              "sockets": { "minItems": 1 },
              "detailInventory": {
                "properties": {
                  "silhouetteFeatures": { "minItems": 2 },
                  "structuralFeatures": { "minItems": 3 },
                  "surfaceFeatures": { "minItems": 2 },
                  "materialIds": { "minItems": 2 },
                  "socketIds": { "minItems": 1 }
                }
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "finiteNumber": { "type": "number" },
    "nonBlank": { "type": "string", "pattern": "\\S" },
    "trimmedNonBlank": { "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "vector3": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "positiveVector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation", "rotationEulerDegrees", "scale"],
      "properties": {
        "translation": { "$ref": "#/$defs/vector3" },
        "rotationEulerDegrees": { "$ref": "#/$defs/vector3" },
        "scale": { "$ref": "#/$defs/positiveVector3" }
      }
    },
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "deterministic", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "deterministic": { "const": true },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonBlank" }
        }
      }
    },
    "blockoutPass": {
      "allOf": [
        { "$ref": "#/$defs/pass" },
        { "properties": { "id": { "const": "blockout" } } }
      ]
    },
    "structurePass": {
      "allOf": [
        { "$ref": "#/$defs/pass" },
        { "properties": { "id": { "const": "structure" } } }
      ]
    },
    "materialsPass": {
      "allOf": [
        { "$ref": "#/$defs/pass" },
        { "properties": { "id": { "const": "materials" } } }
      ]
    },
    "surfaceDetailPass": {
      "allOf": [
        { "$ref": "#/$defs/pass" },
        { "properties": { "id": { "const": "surface-detail" } } }
      ]
    },
    "socketsPass": {
      "allOf": [
        { "$ref": "#/$defs/pass" },
        { "properties": { "id": { "const": "sockets" } } }
      ]
    },
    "detailInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["silhouetteFeatures", "structuralFeatures", "surfaceFeatures", "materialIds", "socketIds"],
      "properties": {
        "silhouetteFeatures": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/trimmedNonBlank" } },
        "structuralFeatures": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/trimmedNonBlank" } },
        "surfaceFeatures": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/trimmedNonBlank" } },
        "materialIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "socketIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "baseColor", "metallic", "roughness"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "baseColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "metallic": { "type": "number", "minimum": 0, "maximum": 1 },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "dimensions", "materialId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primitive": { "enum": ["box", "cylinder", "sphere"] },
        "dimensions": { "$ref": "#/$defs/positiveVector3" },
        "materialId": { "$ref": "#/$defs/id" }
      }
    },
    "socket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeId", "kind", "axis", "amplitude", "frequencyHz"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nodeId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["animation", "attachment"] },
        "axis": { "enum": ["x", "y", "z"] },
        "amplitude": { "type": "number", "minimum": 0 },
        "frequencyHz": { "type": "number", "minimum": 0 }
      }
    },
    "hierarchyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parentId", "componentId", "transform"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parentId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "componentId": { "$ref": "#/$defs/id" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    }
  }
}
