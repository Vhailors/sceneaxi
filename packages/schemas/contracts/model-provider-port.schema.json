{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/model-provider-port/v1",
  "title": "SceneAxi Model Provider Port envelopes (v1)",
  "description": "Provider-neutral descriptors, capability declarations, request/response envelopes, stream chunks, and successful-call evidence. This contract contains no credentials, endpoint configuration, fallback policy, or production provider readiness claim.",
  "oneOf": [
    { "$ref": "#/$defs/capabilities" },
    { "$ref": "#/$defs/completeRequest" },
    { "$ref": "#/$defs/completeResponse" },
    { "$ref": "#/$defs/toolCallRequest" },
    { "$ref": "#/$defs/toolCallResponse" },
    { "$ref": "#/$defs/streamRequest" },
    { "$ref": "#/$defs/streamChunk" },
    { "$ref": "#/$defs/evidence" }
  ],
  "$defs": {
    "profile": {
      "type": "string",
      "pattern": "^@sceneaxi/profile-[a-z][a-z0-9-]*$"
    },
    "model": {
      "type": "object",
      "required": ["model", "provider", "quantization", "version"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "quantization": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["schemaVersion", "operations"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["complete", "tool-call", "stream"] }
        }
      }
    },
    "completeRequest": {
      "type": "object",
      "required": ["schemaVersion", "operation", "profile", "model", "prompt"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "complete" },
        "profile": { "$ref": "#/$defs/profile" },
        "model": { "$ref": "#/$defs/model" },
        "prompt": { "type": "string" }
      }
    },
    "completeResponse": {
      "type": "object",
      "required": ["schemaVersion", "operation", "text", "finishReason"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "complete" },
        "text": { "type": "string" },
        "finishReason": { "type": "string", "enum": ["stop", "length"] }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "inputSchema"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "inputSchema": { "type": "object" }
      }
    },
    "toolCall": {
      "type": "object",
      "required": ["name", "arguments"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" }
      }
    },
    "toolCallRequest": {
      "type": "object",
      "required": ["schemaVersion", "operation", "profile", "model", "prompt", "tools"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "tool-call" },
        "profile": { "$ref": "#/$defs/profile" },
        "model": { "$ref": "#/$defs/model" },
        "prompt": { "type": "string" },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } }
      }
    },
    "toolCallResponse": {
      "type": "object",
      "required": ["schemaVersion", "operation", "toolCalls"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "tool-call" },
        "toolCalls": { "type": "array", "items": { "$ref": "#/$defs/toolCall" } }
      }
    },
    "streamRequest": {
      "type": "object",
      "required": ["schemaVersion", "operation", "profile", "model", "prompt"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "stream" },
        "profile": { "$ref": "#/$defs/profile" },
        "model": { "$ref": "#/$defs/model" },
        "prompt": { "type": "string" }
      }
    },
    "streamChunk": {
      "type": "object",
      "required": ["schemaVersion", "operation", "delta", "done"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "stream" },
        "delta": { "type": "string" },
        "done": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["schemaVersion", "kind", "operation", "profile", "model"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.model-provider-call-evidence" },
        "operation": { "type": "string", "enum": ["complete", "tool-call", "stream"] },
        "profile": { "$ref": "#/$defs/profile" },
        "model": { "$ref": "#/$defs/model" }
      }
    }
  }
}
