{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/rarity/v1",
  "title": "SceneAxi deterministic rarity contracts (v1)",
  "description": "Versioned policy, provider-safe request, authoritative outcome/provenance, and canonical project-owned rarity namespace for sceneaxi.rarity.weighted-sha256-v1.",
  "oneOf": [
    { "$ref": "#/$defs/policy" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/outcome" },
    { "$ref": "#/$defs/provenance" },
    { "$ref": "#/$defs/namespace" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "weight": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tier": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "epic", "legendary"]
    },
    "tierWeights": {
      "type": "object",
      "required": ["common", "uncommon", "rare", "epic", "legendary"],
      "additionalProperties": false,
      "properties": {
        "common": { "$ref": "#/$defs/weight" },
        "uncommon": { "$ref": "#/$defs/weight" },
        "rare": { "$ref": "#/$defs/weight" },
        "epic": { "$ref": "#/$defs/weight" },
        "legendary": { "$ref": "#/$defs/weight" }
      }
    },
    "policy": {
      "type": "object",
      "required": ["schemaVersion", "kind", "tierWeights"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.rarity.policy" },
        "tierWeights": { "$ref": "#/$defs/tierWeights" }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["candidateId", "tier", "weight"],
      "additionalProperties": false,
      "properties": {
        "candidateId": { "$ref": "#/$defs/identifier" },
        "tier": { "$ref": "#/$defs/tier" },
        "weight": { "$ref": "#/$defs/weight" }
      }
    },
    "request": {
      "type": "object",
      "required": ["schemaVersion", "kind", "candidates"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.rarity.request" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/candidate" }
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["schemaVersion", "kind", "tier", "candidateId"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.rarity.outcome" },
        "tier": { "$ref": "#/$defs/tier" },
        "candidateId": { "$ref": "#/$defs/identifier" }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "algorithmId",
        "scope",
        "eventId",
        "policyDigest",
        "requestDigest",
        "tierRollDigest",
        "tierDraw",
        "tierTotalWeight",
        "candidateRollDigest",
        "candidateDraw",
        "candidateTotalWeight",
        "outcomeDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.rarity.provenance" },
        "algorithmId": { "const": "sceneaxi.rarity.weighted-sha256-v1" },
        "scope": { "$ref": "#/$defs/identifier" },
        "eventId": { "$ref": "#/$defs/identifier" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "tierRollDigest": { "$ref": "#/$defs/digest" },
        "tierDraw": { "$ref": "#/$defs/weight" },
        "tierTotalWeight": { "$ref": "#/$defs/weight" },
        "candidateRollDigest": { "$ref": "#/$defs/digest" },
        "candidateDraw": { "$ref": "#/$defs/weight" },
        "candidateTotalWeight": { "$ref": "#/$defs/weight" },
        "outcomeDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "rollRecord": {
      "type": "object",
      "required": ["eventId", "request", "outcome", "provenance"],
      "additionalProperties": false,
      "properties": {
        "eventId": { "$ref": "#/$defs/identifier" },
        "request": { "$ref": "#/$defs/request" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "namespace": {
      "type": "object",
      "required": ["schemaVersion", "kind", "policy", "rolls"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.rarity.namespace" },
        "policy": { "$ref": "#/$defs/policy" },
        "rolls": {
          "type": "array",
          "items": { "$ref": "#/$defs/rollRecord" }
        },
        "providerEvidence": { "$ref": "#/$defs/providerEvidence" }
      }
    },
    "providerEvidence": {
      "type": "object",
      "required": ["schemaVersion", "kind", "operation", "profile", "model"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.model-provider-call-evidence" },
        "operation": { "const": "tool-call" },
        "profile": { "enum": ["@sceneaxi/profile-game", "@sceneaxi/profile-web"] },
        "model": {
          "type": "object",
          "required": ["model", "provider", "quantization", "version"],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:.*[._:/+-])?(?:sk|key|token|secret|credential|password)(?:[._:/+-]|$))[a-z0-9][a-z0-9._:/+-]*$"
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:.*[._:/+-])?(?:sk|key|token|secret|credential|password)(?:[._:/+-]|$))[a-z0-9][a-z0-9._:/+-]*$"
            },
            "quantization": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:.*[._:/+-])?(?:sk|key|token|secret|credential|password)(?:[._:/+-]|$))[a-z0-9][a-z0-9._:/+-]*$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!(?:.*[._:/+-])?(?:sk|key|token|secret|credential|password)(?:[._:/+-]|$))[a-z0-9][a-z0-9._:/+-]*$"
            }
          }
        }
      }
    }
  }
}
