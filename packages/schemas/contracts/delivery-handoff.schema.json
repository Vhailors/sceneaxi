{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/delivery-handoff/v1",
  "title": "SceneAxi Delivery Handoff (v1)",
  "description": "Public, portable, delivery-neutral product export manifest for independent store and CI adapters. Adapter configuration, credentials, approval secrets, and private tool paths are outside this closed contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "product",
    "target",
    "artifacts",
    "artifactSetDigest",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "sceneaxi.delivery-handoff" },
    "product": { "$ref": "#/$defs/product" },
    "target": {
      "enum": ["android", "ios", "desktop", "web"]
    },
    "artifacts": {
      "description": "Portable artifact descriptors keyed by their unique relative POSIX paths.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 1024,
        "pattern": "^(?!/)(?![\\s\\S]*/$)(?![\\s\\S]*//)(?![\\s\\S]*\\\\)(?!\\.\\.?(?:/|$))(?![\\s\\S]*/\\.\\.?(?:/|$))(?:(?:[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]))+$"
      },
      "additionalProperties": { "$ref": "#/$defs/artifact" }
    },
    "artifactSetDigest": {
      "description": "sha256 of the RFC 8785 canonical JSON representation of the artifacts object.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "contentType", "digest"],
      "properties": {
        "role": {
          "enum": [
            "application",
            "asset-bundle",
            "metadata",
            "debug-symbols",
            "other"
          ]
        },
        "contentType": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt"],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "build": { "$ref": "#/$defs/build" }
      }
    }
  }
}
