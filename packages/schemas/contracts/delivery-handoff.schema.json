{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/delivery-handoff/v1",
  "title": "SceneAxi Delivery Handoff (v1)",
  "description": "Public, portable, delivery-neutral product export manifest for independent store and CI adapters. Adapter configuration, credentials, approval secrets, and private tool paths are outside this closed contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "product",
    "targets",
    "artifacts",
    "artifactSetDigest",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "sceneaxi.delivery-handoff" },
    "product": { "$ref": "#/$defs/product" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["android", "ios", "desktop", "web"]
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "artifactSetDigest": {
      "description": "sha256 of the RFC 8785 canonical JSON representation of the artifacts array, preserving array order.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "contentType", "digest"],
      "properties": {
        "path": {
          "description": "Relative POSIX path inside the portable export package; absolute, backslash, empty, dot, and parent segments are refused.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+$"
        },
        "role": {
          "enum": [
            "application",
            "asset-bundle",
            "metadata",
            "debug-symbols",
            "other"
          ]
        },
        "contentType": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "sourceCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "build": { "$ref": "#/$defs/build" }
      }
    }
  }
}
