{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/delivery-handoff/v1",
  "title": "SceneAxi Delivery Handoff (v1)",
  "description": "Public, portable, delivery-neutral product export manifest for independent store and CI adapters. Adapter configuration, credentials, approval secrets, and private tool paths are outside this closed contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "product",
    "target",
    "artifacts",
    "artifactSetDigest",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "sceneaxi.delivery-handoff" },
    "product": { "$ref": "#/$defs/product" },
    "target": {
      "enum": ["android", "ios", "desktop", "web"]
    },
    "artifacts": {
      "description": "Portable artifact descriptors keyed by their unique relative POSIX paths.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 1024,
        "pattern": "^(?!/)(?![\\s\\S]*/(?![\\s\\S]))(?![\\s\\S]*//)(?![\\s\\S]*\\\\)(?!\\.\\.?(?:/|(?![\\s\\S])))(?![\\s\\S]*/\\.\\.?(?:/|(?![\\s\\S])))(?:(?:[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]))+(?![\\s\\S])"
      },
      "additionalProperties": { "$ref": "#/$defs/artifact" }
    },
    "artifactSetDigest": {
      "description": "sha256 of the RFC 8785 canonical JSON representation of the artifacts object.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "notes": {
      "allOf": [{ "$ref": "#/$defs/unicodeScalarString" }],
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"
        },
        "displayName": {
          "allOf": [{ "$ref": "#/$defs/unicodeScalarString" }],
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "version": {
          "allOf": [{ "$ref": "#/$defs/unicodeScalarString" }],
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "contentType", "digest"],
      "properties": {
        "role": {
          "enum": [
            "application",
            "asset-bundle",
            "metadata",
            "debug-symbols",
            "other"
          ]
        },
        "contentType": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*(?![\\s\\S])"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "allOf": [{ "$ref": "#/$defs/unicodeScalarString" }],
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "tool": {
          "allOf": [{ "$ref": "#/$defs/unicodeScalarString" }],
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "startedAt": { "$ref": "#/$defs/dateTime" },
        "completedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt"],
      "properties": {
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "sourceCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
        },
        "build": { "$ref": "#/$defs/build" }
      }
    },
    "unicodeScalarString": {
      "description": "I-JSON-safe string containing only Unicode scalar values.",
      "type": "string",
      "pattern": "^(?:(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]))*(?![\\s\\S])"
    },
    "dateTime": {
      "description": "Non-leap RFC 3339 date-time with independently asserted Gregorian calendar, clock, and offset ranges.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8])))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)(?![\\s\\S])"
    }
  }
}
