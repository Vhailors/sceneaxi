{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneaxi.invalid/contracts/desktop-local-bridge/v1",
  "title": "SceneAxi desktop local bridge protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/discovery" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/tool" }
  ],
  "$defs": {
    "permission": {
      "enum": ["bridge:connect", "project:read", "project:write", "assistant:read", "assistant:run"]
    },
    "editorCommandId": {
      "enum": [
        "project-new",
        "project-inspect",
        "project-migration-propose",
        "project-migration-commit",
        "project-migration-recover",
        "ship-export-web",
        "project-open",
        "project-save",
        "edit-undo",
        "edit-redo",
        "scene-hierarchy-inspect",
        "scene-selection-set",
        "scene-object-create",
        "scene-object-remove",
        "scene-object-reparent",
        "run-play",
        "change-review-accept",
        "change-review-reject",
        "assistant-local-build",
        "assistant-byo-build",
        "assistant-local-agent",
        "assistant-status",
        "assistant-cancel"
      ]
    },
    "toolName": {
      "enum": [
        "sceneaxi.bridge.handshake",
        "sceneaxi.project.status",
        "sceneaxi.project.inspect",
        "sceneaxi.project.migration.propose",
        "sceneaxi.project.migration.commit",
        "sceneaxi.project.migration.recover",
        "sceneaxi.scene.hierarchy.inspect",
        "sceneaxi.scene.selection.set",
        "sceneaxi.scene.object.create",
        "sceneaxi.scene.object.remove",
        "sceneaxi.scene.object.reparent",
        "sceneaxi.project.propose",
        "sceneaxi.project.accept",
        "sceneaxi.project.reject",
        "sceneaxi.project.recover",
        "sceneaxi.project.restart",
        "sceneaxi.project.undo",
        "sceneaxi.project.redo",
        "sceneaxi.run.play",
        "sceneaxi.assistant.local.start",
        "sceneaxi.assistant.byo.start",
        "sceneaxi.assistant.local.agent",
        "sceneaxi.assistant.status",
        "sceneaxi.assistant.abandon"
      ]
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "kind", "transport", "instanceId", "socketPath", "capability", "pid", "projectRoot", "permissions"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "kind": { "const": "sceneaxi.desktop-local-bridge-discovery" },
        "transport": { "const": "unix-ndjson" },
        "instanceId": { "type": "string", "minLength": 1 },
        "socketPath": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,}$" },
        "pid": { "type": "integer", "minimum": 1 },
        "projectRoot": { "type": "string", "minLength": 1 },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permission" }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "id", "capability", "permission", "tool", "input"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "permission": { "$ref": "#/$defs/permission" },
        "tool": { "$ref": "#/$defs/toolName" },
        "input": { "type": "object" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "detail": { "type": ["string", "null"] },
        "transaction": { "type": "object" }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "id", "ok", "result"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "type": "string" },
            "ok": { "const": true },
            "result": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "id", "ok", "error"],
          "properties": {
            "protocolVersion": { "const": 1 },
            "id": { "type": "string" },
            "ok": { "const": false },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "commandId", "description", "permission", "mutatesProject", "providerRoute", "creditRoute", "inputSchema"],
      "properties": {
        "name": { "$ref": "#/$defs/toolName" },
        "commandId": {
          "oneOf": [
            { "$ref": "#/$defs/editorCommandId" },
            { "type": "null" }
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "permission": { "$ref": "#/$defs/permission" },
        "mutatesProject": { "type": "boolean" },
        "providerRoute": { "enum": ["none", "byo"] },
        "creditRoute": { "const": "none" },
        "inputSchema": { "type": "object" }
      }
    }
  }
}
