   * surface (`CATALOG_SITE_FOUNDATION_SURFACE` → `web-assets`) and site-kit resolves the
   * accent for it, so `--store-web` has exactly one declaration in the repository.
   *
   * These are the storefront's own derivations, each transcribed from the Asset
   * Storefronts screen, which the Foundations sheet does not publish. The glow is mixed
   * from the resolved accent rather than restated as a second literal.
   */
  --accent-bg: #0c2226;
  --accent-line: #1d4a52;
  --accent-glow: color-mix(in srgb, var(--accent) 70%, transparent);
  --hero-wash: linear-gradient(100deg, #08171a 0%, #0a0c0e 62%);
  --media-wash: radial-gradient(120% 100% at 50% 8%, #0e1f23, var(--bg-field));
  --mark-radius: 50%;

  /*
   * Density, recorded as DEC-10 of the redesign (\"cooler, calmer\"). The archive calls the
   * web store the calmer of the two, so its shelf gives each scene a wider cell on a looser
   * gap: the one scene and the publish slot share a row at 1440px, each at least 440px.
   */
  --card-min: 22rem;
  --grid-gap: 24px;
}

/* --- END STORE IDENTITY --- */

/* --- layout measures this storefront owns; the token layer arrives from site-kit --- */

:root {
  color-scheme: dark;

  /*
   * The resolved font stacks. `--font-ui` and `--font-mono` are site-kit's tokens and name
