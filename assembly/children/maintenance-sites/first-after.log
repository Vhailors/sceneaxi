 *
 * The Asset Storefronts screen in the accepted SceneAxi Design System archive holds both
 * catalogs in one file and flips between them at runtime. ADR 0018 makes each storefront
 * its own install root and its own deployed origin, so what the design calls a store
 * switch ships here as two sites that share one skeleton and differ only in the block
 * marked STORE IDENTITY below. Everything after that block is byte-identical to
 * `sites/catalog-web/src/app/globals.css`, and a gate test keeps it that way.
 *
 * Two deliberate departures from the archive, both recorded in the visual gap matrix as
 * defects in the design rather than in the code:
 *
 *   Q-01  The mockup has no responsive behaviour at all — a real-browser probe measured
 *         scrollWidth 984 against innerWidth 390. Every fixed grid below is therefore
 *         declared single-column first and widened at a breakpoint, and `body` carries no
 *         `overflow-x: hidden`, so an overflow would show up in a probe instead of being
 *         masked by it.
 *   Q-03  The archive's micro type is 8.5px mono in `--fg-4` on `--bg-panel`, which
 *         measures about 2.1:1. `--fg-4` is not used for text anywhere here, and no rule
 *         below sets text smaller than `--micro`, 11px. The gate reads the shipped
 *         `font-size` declarations for that floor and computes the contrast of every text
 *         pairing in `tests/sites/catalog-storefronts.test.ts`.
 *
 * The palette is dark only, as the archive is. There is no light variant anywhere in the
 * accepted source, and inventing one would be designing rather than implementing.
 *
 * This sheet declares no Foundations v2 token. The palette, the type scale, the radii,
 * the surfaces, the motion timings and the status vocabulary are emitted by
 * `@sceneaxi/site-kit` and served by `layout.tsx` (`src/lib/foundations.ts`), which is the
 * single home the captain's D2 decision gives the shared token layer. What remains below
 * is what this storefront itself owns: the per-store derivations marked STORE IDENTITY,
 * the layout measures its own `:root` block declares, and its own components.
 */

/* --- STORE IDENTITY — the only block that differs between the two storefronts --- */

:root {
  /*
   * `--accent` and `--accent-hi` are *not* here. This storefront names its Foundations
   * surface (`CATALOG_SITE_FOUNDATION_SURFACE` → `game-assets`) and site-kit resolves the
   * accent for it, so `--store-game` has exactly one declaration in the repository.
   *
   * These are the storefront's own derivations, each transcribed from the Asset
   * Storefronts screen, which the Foundations sheet does not publish. The glow is mixed
   * from the resolved accent rather than restated as a second literal.
   */
  --accent-bg: #20100f;
  --accent-line: #4e2523;
  --accent-glow: color-mix(in srgb, var(--accent) 75%, transparent);
  --hero-wash: linear-gradient(100deg, #120a09 0%, #0a0c0e 62%);
  --media-wash: radial-gradient(120% 100% at 50% 8%, #1e1512, var(--bg-field));
  --mark-radius: 1px;

  /*
   * Density, recorded as DEC-10 of the redesign (\"warmer, denser\"). The archive calls the
   * game store the denser of the two, so its shelf packs narrower cells on a tighter gap:
   * three listings and the publish slot share one row at 1440px.
   */
  --card-min: 14rem;
  --grid-gap: 16px;
}

/* --- END STORE IDENTITY --- */

/* --- layout measures this storefront owns; the token layer arrives from site-kit --- */

:root {
  color-scheme: dark;

  /*
   * The resolved font stacks. `--font-ui` and `--font-mono` are site-kit's tokens and name
   * Archivo and JetBrains Mono; `--site-font-*` are the self-hosted faces `layout.tsx`
   * loads through `next/font`, since a package must not inject a network font. Prepending
   * the loaded face keeps site-kit the source of what the family *is* and leaves this site
   * responsible only for having it available.
   */
  --store-ui: var(--site-font-ui), var(--font-ui);
  --store-mono: var(--site-font-mono), var(--font-mono);

  --measure: 64ch;
  --shell: 1340px;
  --gutter: var(--space-4);
  --micro: 0.6875rem;

  /* The vertical rhythm of a page band: 44px on a phone and a tablet, 72px on a desktop. */
  --section-pad: var(--space-11);

  /*
   * How far below the sticky masthead a sticky column pins and a fragment target lands,
   * and therefore how much of the viewport is left for a bounded column. Declared once so
   * the offset and the height that depends on it cannot drift apart into a column that
   * clips its own tail.
   *
   * Below 36rem the masthead is two rows, the storemark over one scrolling nav line, and
   * measures at most 96px. This is the two-row value, so the narrow case (the one where
   * an anchor would otherwise land behind the masthead) is the default rather than the
   * exception.
   */
  --sticky-top: 8rem;
}

/*
 * From 36rem the storemark and the nav share one 64px row, so the offset returns to the
 * one-row value: a two-row offset held at every width would charge every anchor
 * destination, on every viewport, dead space no masthead is occupying.
 */
@media (min-width: 36rem) {
  :root {
    --sticky-top: 5.5rem;
  }
}

@media (min-width: 60rem) {
  :root {
    --gutter: var(--space-8);
  }
}

/* --- base --- */

/*
 * The reset, the near-black canvas, the Archivo body text and the link colour all come
 * from site-kit's `foundationsBaseCss()`. Only what that sheet does not state is here.
 */

* {
  /* Grid and flex children default to `min-width: auto`, which is how a long digest or a
   * mono label pushes a track wider than its container and overflows the page. */
  min-width: 0;
}

html {
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
  /*
   * The masthead is sticky, so a fragment target scrolled to y=0 lands underneath it —
   * including `#main`, which the skip link is the only way to reach. Pinning the scroll
   * padding at the same offset the sticky columns use keeps every anchor destination,
   * and the top of `<main>`, below the masthead rather than behind it. Independent of
   * `scroll-behavior`, so it holds under reduced motion too.
   */
  scroll-padding-top: var(--sticky-top);
}

/*
 * `html body` rather than `body`: site-kit's Foundations sheet is served from `layout.tsx`
 * and lands after this file, and it also sets `body { font-family: var(--font-ui) }`. One
 * extra element in the selector makes this rule win by specificity instead of by load
 * order, so the self-hosted faces are used whichever sheet the framework emits first.
 *
 * The body size is the dense-copy step, 14px, so text that no component sizes still lands
 * on the page's type ramp instead of adding a size to it.
 */
html body {
  font-family: var(--store-ui);
  font-size: 0.875rem;
  line-height: 1.6;
  /*
   * No `overflow-x: hidden`. Horizontal overflow is a layout defect, and hiding it here
   * would also hide it from the scrollWidth probe that proves the fix.
   */
}

/*
 * Foundations prints `--accent-hi` for signal orange only, and site-kit refuses to invent
 * a lighter tint for a storefront accent (`resolveSurfaceAccent`, recorded as D-3 in
 * `docs/design-foundations.md`). Accent is also reserved for the primary action, the
 * current nav item, pending chips and the store mark, so a plain inline link is set in
 * the text colour and carries an underline that brightens on hover: colour is never the
 * only cue, and no hover hue is minted.
 *
 * Every link that is really a card, tab, crumb or button sets its own rest and hover
 * state below with a class selector, which outranks both this rule and site-kit's
 * `a:hover` whatever order the two sheets load in.
 */
html body a {
  color: var(--fg);
  text-decoration-line: underline;
  text-decoration-color: var(--line-strong);
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
  transition:
    color var(--motion-fast) var(--ease-standard),
    text-decoration-color var(--motion-fast) var(--ease-standard);
}

html body a:hover {
  color: var(--fg);
  text-decoration-color: currentColor;
}

/*
 * One ring for every focusable element, drawn outside it. No `border-radius` override:
 * an outline follows the radius of the element it belongs to, so the ring is square on
 * a square control and rounded on a card.
 */
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 4px;
}

@media (forced-colors: active) {
  :focus-visible {
    outline-color: Highlight;
  }
}

img,
svg {
  max-width: 100%;
}

code,
kbd,
pre {
  font-family: var(--store-mono);
}


@keyframes sa-rise {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

/* --- shell --- */

.shell {
  max-width: var(--shell);
  margin: 0 auto;
  padding: 0 var(--gutter);
  width: 100%;
}

/* A plain document page: the 404 and the error boundary. */
.page {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-6);
  padding-top: var(--section-pad);
  padding-bottom: var(--section-pad);
}

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  z-index: 100;
  background: var(--accent);
  color: var(--bg-base);
  padding: var(--space-3) var(--space-4);
  font-size: 0.875rem;
  font-weight: 600;
}

.skip-link:focus {
  left: 0;
  color: var(--bg-base);
  text-decoration: none;
}

/* Available to assistive technology, absent from the visual composition. */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
}

/*
 * A text glyph: `→` for an action, `↗` for a link that leaves this origin, `›` between
 * crumbs, `✓` on a record row. Always `aria-hidden` in markup (D-7), so a glyph repeats
 * what the words say and never carries a fact alone. The one that moves is the action
 * arrow, 3px to the right, which is the whole of the transform budget D-4 gives it.
 */
.glyph {
  font-style: normal;
  line-height: 1;
}

/*
 * Only the moving arrow is an inline block, because a transform needs one. A plain glyph
 * stays inline, so no line can break between it and the word it follows.
 */
.glyph-nudge {
  display: inline-block;
  transition: transform var(--motion-base) var(--ease-standard);
}

/* --- family bar --- */

.family {
  background: #0a0c0e;
  border-bottom: 1px solid var(--line-soft);
}

/*
 * One row at every width. On a phone it scrolls inside itself rather than wrapping into
 * a three-line strip, and the domain line, which is the one entry nobody navigates by,
 * waits for 36rem.
 */
.family-inner {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-height: 1.6875rem;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  scrollbar-width: none;
  mask-image: linear-gradient(90deg, #000 calc(100% - 2rem), transparent);
}

.family-inner::-webkit-scrollbar {
  display: none;
}

.family-brand {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  flex: none;
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1;
  color: var(--fg-2);
}

/* The SceneAxi family mark, in the neutral text colour: the bar belongs to the family,
 * not to this store, so the store accent stays on the storemark below it. */
.family-glyph {
  width: 14px;
  height: 14px;
  border-radius: var(--radius-sm);
  background: var(--fg-2);
  display: grid;
  place-items: center;
  flex: none;
}

.family-glyph::after {
  content: \"\";
  width: 5px;
  height: 5px;
  border: 1.5px solid #0a0c0e;
  transform: rotate(45deg);
}

.family nav {
  flex: none;
}

.family-list {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  list-style: none;
  margin: 0;
  padding: 0;
}

.family-item {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 1.6875rem;
  font-size: 0.8125rem;
  line-height: 1;
  white-space: nowrap;
  color: var(--fg-2);
}

html body a.family-item {
  color: var(--fg-2);
  text-decoration-color: transparent;
}

html body a.family-item:hover {
  color: var(--fg);
  text-decoration-color: currentColor;
}

.family-item.is-current {
  color: var(--fg);
  font-weight: 600;
}

.family-dot {
  width: 6px;
  height: 6px;
  border-radius: var(--radius-full);
  flex: none;
}

.family-out {
  color: var(--fg-2);
}

.family-domain {
  display: none;
  flex: none;
  margin-left: auto;
  font-family: var(--store-mono);
  font-size: var(--micro);
  letter-spacing: 0.02em;
  color: var(--fg-2);
  white-space: nowrap;
}

/* --- masthead --- */

.masthead {
  position: sticky;
  top: 0;
  z-index: 30;
  background: color-mix(in srgb, var(--bg-base) 90%, transparent);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--line-soft);
}

/*
 * A phone gets two rows, the storemark and then one scrolling nav line of 44px targets,
 * 93px in all. From 36rem both share one 64px row.
 */
.masthead-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: var(--space-6);
  padding-top: var(--space-2);
}

html body .storemark {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  min-height: 2.5rem;
  border-radius: var(--radius-md);
  color: var(--fg);
  text-decoration: none;
}

/*
 * Load-bearing, not a repeat of the rule above: site-kit ships its own
 * `a:hover { color: var(--accent-hi) }`, and the wordmark is a real link, so without this
 * the accent would shift a mark the archive deliberately gives no hover state. Restating
 * `--fg` at higher specificity suppresses that inherited change instead of minting a
 * hover this design system does not publish. Do not delete it as redundant.
 */
html body .storemark:hover {
  color: var(--fg);
}

/*
 * The store mark is a shape, not a colour: the tile and its knock-out both take the
 * store's `--mark-radius`, a square on the game store and a circle on the web store, at
 * every size it is drawn (32px here, 20px in the footer).
 */
.storemark-glyph {
  width: 32px;
  height: 32px;
  border-radius: var(--mark-radius);
  background: var(--accent);
  display: grid;
  place-items: center;
  flex: none;
  box-shadow: 0 4px 16px -5px var(--accent-glow);
}

.storemark-glyph::after {
  content: \"\";
  width: 12px;
  height: 12px;
  border: 2px solid var(--bg-base);
  border-radius: var(--mark-radius);
}

.storemark-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.storename {
  font-size: 1.0625rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.storetag {
  font-family: var(--store-mono);
  font-size: var(--micro);
  font-weight: 500;
  letter-spacing: 0.12em;
  line-height: 1.2;
  color: var(--accent);
}

.nav {
  flex: 1 0 calc(100% + 20px);
  display: flex;
  align-items: center;
  gap: var(--space-1);
  margin-inline: -10px;
  overflow-x: auto;
  scrollbar-width: none;
}

.nav::-webkit-scrollbar {
  display: none;
}

html body .nav a {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  flex: none;
  min-height: 2.75rem;
  padding: 0 10px;
  border-radius: var(--radius-md);
  font-size: 0.875rem;
  font-weight: 500;
  white-space: nowrap;
  color: var(--fg-2);
  text-decoration: none;
  transition:
    color var(--motion-fast) var(--ease-standard),
    background-color var(--motion-fast) var(--ease-standard);
}

html body .nav a:hover {
  color: var(--fg);
  background: var(--bg-row);
}

/* The current section: the text level steps up and a 2px accent bar sits under it, so it
 * reads without colour as well as with it. */
html body .nav a[aria-current=\"page\"] {
  color: var(--fg);
}

.nav a[aria-current=\"page\"]::after {
  content: \"\";
  position: absolute;
  left: 10px;
  right: 10px;
  bottom: 4px;
  height: 2px;
  border-radius: var(--radius-full);
  background: var(--accent);
}

/* --- typography --- */

h1,
h2,
h3 {
  margin: 0;
  text-wrap: balance;
}

/*
 * Route display type: 52px at 1440, 36px on a phone, on the width axis the Foundations
 * display step is specified at (104), which `layout.tsx` loads Archivo with.
 */
h1 {
  font-size: clamp(2.25rem, 1.55rem + 1.95vw, 3.25rem);
  font-variation-settings: \"wdth\" 104;
  line-height: 1.04;
  letter-spacing: -0.03em;
  font-weight: 700;
}

/*
 * Section headings: 36px at 1440 and 28px on a phone. The ceiling sits below the 42px
 * display step on purpose, because a page heading has to stay at least 1.4 times its
 * section headings and the route H1 is 52px.
 */
h2 {
  font-size: clamp(1.75rem, 1.2rem + 1.7vw, 2.25rem);
  line-height: 1.08;
  letter-spacing: -0.03em;
  font-weight: 700;
}

h3 {
  font-size: 0.9375rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.35;
}

p {
  margin: 0;
}

.lede {
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--fg-2);
  max-width: 52ch;
  text-wrap: pretty;
}

.prose {
  font-size: 0.875rem;
  line-height: 1.65;
  color: var(--fg-2);
  max-width: var(--measure);
  text-wrap: pretty;
}

.note {
  font-size: 0.8125rem;
  line-height: 1.6;
  color: var(--fg-2);
  max-width: var(--measure);
  text-wrap: pretty;
}

/* Evidence read out of a contract: a rounding rule, a reference, a timestamp. */
.mono-note {
  font-family: var(--store-mono);
  font-size: 0.75rem;
  line-height: 1.6;
  letter-spacing: 0.02em;
  color: var(--fg-2);
  max-width: var(--measure);
  overflow-wrap: anywhere;
}

.eyebrow,
.micro {
  font-family: var(--store-mono);
  font-size: var(--micro);
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--fg-2);
}

.section {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

/* --- chips --- */

.chip {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  min-height: 1.25rem;
  padding: 0 6px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--bg-base) 88%, transparent);
  font-family: var(--store-mono);
  font-size: var(--micro);
  font-weight: 500;
  letter-spacing: 0.06em;
  line-height: 1;
  text-transform: uppercase;
  white-space: nowrap;
  color: var(--fg-2);
}

/* `TEST` is the one pending chip, so it is the one that carries the accent. */
.chip-accent {
  color: var(--accent);
  border-color: var(--accent-line);
  background: var(--accent-bg);
}

/* --- actions --- */

/*
 * Two sizes from the Foundations button table and no others: lg 38/13/5 and xl 46/15/6.
 * `.button` is lg; `.button-xl` steps it up.
 */
html body .button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  min-height: 2.375rem;
  padding: 0 18px;
  border-radius: var(--radius-md);
  border: 1px solid var(--accent);
  background: var(--accent);
  color: var(--bg-base);
  font: inherit;
  font-size: 0.8125rem;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  text-decoration: none;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
  cursor: pointer;
  transition:
    background-color var(--motion-fast) var(--ease-standard),
    border-color var(--motion-fast) var(--ease-standard),
    color var(--motion-fast) var(--ease-standard),
    box-shadow var(--motion-fast) var(--ease-standard);
}

html body .button-xl {
  min-height: 2.875rem;
  padding: 0 24px;
  border-radius: 6px;
  font-size: 0.9375rem;
}

html body .button-block {
  width: 100%;
}

/*
 * The primary button keeps its accent fill on hover. `--accent-hi` resolves to the accent
 * itself on a storefront surface (site-kit states no hover shade outside signal orange),
 * so the state change is a ring in the store's own `--accent-line` and a stronger top
 * highlight — both values this storefront already owns — rather than an invented tint.
 */
html body .button:hover {
  color: var(--bg-base);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.45),
    0 0 0 3px var(--accent-bg),
    0 0 0 4px var(--accent-line);
}

html body .button-quiet {
  background: transparent;
  border-color: var(--line-strong);
  color: var(--fg);
  box-shadow: none;
}

html body .button-quiet:hover {
  background: var(--bg-control);
  border-color: var(--fg-2);
  color: var(--fg);
  box-shadow: none;
}

html body .button[aria-disabled=\"true\"],
html body .button[aria-disabled=\"true\"]:hover {
  background: transparent;
  border-color: var(--line-strong);
  color: var(--fg-2);
  box-shadow: none;
  cursor: not-allowed;
}

.button:hover .glyph-nudge,
.slot-link:hover .glyph-nudge {
  transform: translateX(3px);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  align-items: center;
}

/* --- hero --- */

/*
 * The archived wash, lit by one neutral light where the lead record sits and settling
 * toward the page's own base along the lower edge. Every stop is a palette neutral (D-5):
 * the light is `--bg-raised` itself, so the brightest point of the band is exactly that
 * surface's luminance and every text pairing on it is one the gate already measures; the
 * store accent, which means pending here, takes no part in it.
 */
.hero {
  --spot-at: 50% 82%;
  background:
    linear-gradient(to bottom, transparent 55%, color-mix(in srgb, var(--bg-base) 70%, transparent)),
    radial-gradient(36rem 28rem at var(--spot-at), var(--bg-raised) 55%, transparent),
    var(--hero-wash);
  border-bottom: 1px solid var(--line-soft);
}

.hero-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-4);
  align-items: center;
  padding-top: var(--section-pad);
  padding-bottom: var(--section-pad);
}

.hero-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-4);
}

.kicker {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 1.625rem;
  padding: 0 var(--space-3);
  border: 1px solid var(--accent-line);
  background: var(--accent-bg);
  border-radius: var(--radius-full);
  font-family: var(--store-mono);
  font-size: var(--micro);
  font-weight: 500;
  letter-spacing: 0.12em;
  line-height: 1.2;
  color: var(--fg-2);
}

.kicker-dot {
  width: 6px;
  height: 6px;
  border-radius: var(--radius-full);
  background: var(--accent);
  /* A fixture marker is not live activity: hold it still. */
  animation: none;
  flex: none;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-3);
  width: 100%;
}

/* On a phone the primary action takes the full width and the quiet one keeps its own,
 * so the two never read as equals. */
.hero-actions .button:first-child {
  flex: 1 0 100%;
}

.hero-plate {
  display: flex;
  flex-direction: column;
}

/* --- record plates: the card, hero and detail figure --- */

/*
 * Everything drawn on a plate is either a pure function of the validated listing record's
 * own digest (the mark) or a real fact printed on it (the chips, the legend). Nothing
 * depicts an asset, which is why the plate carries a legend that names what it is.
 */
.plate {
  position: relative;
  display: block;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  isolation: isolate;
  background: radial-gradient(120% 100% at 50% 12%, #191e25, var(--bg-field));
}

.plate-lead,
.plate-detail {
  background: var(--media-wash);
}

/* The detail figure is framed on its own; the lead plate is framed by the link around it. */
.plate-detail {
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-lg);
  box-shadow: var(--surface-float-shadow);
}

.plate-media {
  position: absolute;
  inset: 0;
  transition: transform var(--motion-base) var(--ease-standard);
}

.plate-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
  background-size: 24px 24px;
  background-position: center;
}

/*
 * The mark itself. Its greys come from the digest; the store accent is mixed in at 20%,
 * the most D-5 lets a record mark take, as identity rather than meaning. No text sits on
 * it: every label on a plate carries its own backing.
 */
.plate-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--chip-w);
  height: var(--chip-h);
  border-radius: var(--radius-sm);
  background: linear-gradient(
    155deg,
    color-mix(in srgb, var(--chip-from) 80%, var(--accent)),
    color-mix(in srgb, var(--chip-to) 80%, var(--accent))
  );
  box-shadow: 0 16px 30px -14px #000;
  transform: translate(-50%, -50%) rotate(var(--chip-rot)) skewX(var(--chip-skew));
}

.plate-chips {
  position: absolute;
  left: var(--space-3);
  top: var(--space-3);
  right: var(--space-3);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.plate-legend,
.plate-digest,
.plate-stat {
  position: absolute;
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 1.375rem;
  padding: 0 var(--space-2);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--bg-base) 88%, transparent);
  font-family: var(--store-mono);
  font-size: var(--micro);
  letter-spacing: 0.04em;
  line-height: 1;
  white-space: nowrap;
  color: var(--fg-2);
}

.plate-legend strong,
.plate-stat strong {
  color: var(--fg);
  font-weight: 500;
}

.plate-digest {
  right: var(--space-3);
  bottom: var(--space-3);
}

.plate-legend {
  left: var(--space-3);
  bottom: var(--space-3);
}

.plate-detail .plate-chips {
  left: var(--space-4);
  top: var(--space-4);
  right: auto;
}

.plate-stats {
  position: absolute;
  left: var(--space-4);
  right: var(--space-4);
  bottom: var(--space-4);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.plate-stats .plate-legend,
.plate-stat {
  position: static;
  font-size: 0.75rem;
  min-height: 1.5rem;
}

.plate-empty {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  padding: var(--space-4);
  text-align: center;
  font-family: var(--store-mono);
  font-size: var(--micro);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--fg-2);
}

/* The lead plate: the first listing, framed as a float surface (D-6) with a caption bar. */
html body .lead {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-lg);
  background: var(--bg-raised);
  box-shadow: var(--surface-float-shadow);
  color: var(--fg);
  text-decoration: none;
  transition: border-color var(--motion-fast) var(--ease-standard);
}

html body .lead:hover {
  color: var(--fg);
  border-color: var(--fg-2);
}

.lead-caption {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-1) var(--space-4);
  padding: 10px var(--space-4);
  border-top: 1px solid var(--line);
}

.lead-title {
  font-size: 1.0625rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.3;
  text-decoration-line: underline;
  text-decoration-color: transparent;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.18em;
  transition: text-decoration-color var(--motion-fast) var(--ease-standard);
}

/* --- price, as the card, the lead plate and the related cards print it --- */

.price {
  display: inline-flex;
  flex-wrap: wrap;
  align-items: baseline;
  column-gap: var(--space-1);
  line-height: 1.3;
}

.price-num {
  font-size: 0.9375rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--fg);
}

.price-unit,
.price-or {
  font-size: 0.75rem;
  color: var(--fg-2);
}

.price-or {
  margin-left: var(--space-1);
}

.price-alt {
  font-family: var(--store-mono);
  font-size: 0.75rem;
  color: var(--fg);
}

/* --- facts strip --- */

.facts {
  border-bottom: 1px solid var(--line-soft);
}

.facts-list {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  list-style: none;
  margin: 0;
  padding: 0;
}

.fact {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-2) var(--space-3) var(--space-2) 0;
}

/*
 * On a phone the two short facts (count, share) share the first row and the two longer
 * ones the second; the list keeps its reading order, and 48rem restores it on screen.
 */
.fact:nth-child(1) {
  order: 1;
}

.fact:nth-child(3) {
  order: 2;
}

.fact:nth-child(2) {
  order: 3;
}

.fact:nth-child(4) {
  order: 4;
}

.fact:nth-child(3),
.fact:nth-child(4) {
  padding: var(--space-2) 0 var(--space-2) var(--space-3);
  border-left: 1px solid var(--line-soft);
}

.fact:nth-child(2),
.fact:nth-child(4) {
  border-top: 1px solid var(--line-soft);
}

.fact-value {
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.1;
  color: var(--fg);
}

.fact-label {
  font-size: 0.8125rem;
  line-height: 1.45;
  color: var(--fg-2);
}

/* --- browse --- */

.browse {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-4);
  align-items: start;
  padding-top: var(--section-pad);
  padding-bottom: var(--section-pad);
}

/*
 * The rail is a tally of what the page holds, not a filter: no checkbox, no fill, no
 * pointer. On a phone and a tablet it is one row of group cards that scrolls inside
 * itself and is focusable, so the listings arrive within a screen and a half.
 */
.rail {
  display: flex;
  gap: var(--space-3);
  overflow-x: auto;
  overscroll-behavior-x: contain;
  scroll-snap-type: x proximity;
  scrollbar-width: thin;
  scrollbar-color: var(--line-strong) transparent;
  padding-bottom: var(--space-1);
}

.rail-group,
.rail-note {
  flex: 0 0 15rem;
  scroll-snap-align: start;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: 10px var(--space-3);
  background: var(--bg-panel);
  border: 1px solid var(--line-soft);
  border-radius: var(--radius-lg);
}

.rail-title {
  font-family: var(--store-mono);
  font-size: var(--micro);
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--fg);
}

.rail-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.rail-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: baseline;
  column-gap: var(--space-3);
  row-gap: var(--space-1);
  font-size: 0.875rem;
  line-height: 1.35;
  color: var(--fg);
}

.rail-name {
  overflow-wrap: anywhere;
}

.rail-count {
  font-family: var(--store-mono);
  font-size: 0.75rem;
  color: var(--fg-2);
}

/* The row's share of the page, as a 2px bar: count over total, never a control. */
.rail-bar {
  grid-column: 1 / -1;
  position: relative;
  height: 2px;
  border-radius: var(--radius-full);
  background: var(--line-soft);
  overflow: hidden;
}

.rail-bar::after {
  content: \"\";
  position: absolute;
  inset: 0 auto 0 0;
  width: calc(var(--share, 0) * 100%);
  border-radius: inherit;
  background: var(--fg-2);
}

.rail-note {
  flex-basis: 24rem;
}

.rail-note p {
  font-size: 0.8125rem;
  line-height: 1.55;
  color: var(--fg-2);
  text-wrap: pretty;
}

.rail-note p:first-child {
  color: var(--fg);
  font-weight: 600;
}

.results {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.results-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--space-1) var(--space-3);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--line-soft);
}

.results-count {
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.1;
  color: var(--fg);
}

.results-word {
  font-weight: 400;
  color: var(--fg-2);
}

.results-surface {
  font-size: 0.875rem;
  color: var(--fg-2);
}

/* The GET controls keep their contracts; layout groups labels above their fields.
 * SAFETY: only presentation changes; no controls are hidden or visually reordered
 * across tasks. The two price/sort fields regroup on mobile rather than shrink. */
.catalog-controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-areas:
    \"search-label\"
    \"search\"
    \"search-help\"
    \"price-label\"
    \"price\"
    \"sort-label\"
    \"sort\"
    \"apply\"
    \"clear\";
  gap: 0.75rem 1rem;
  padding: 1.25rem;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-lg);
  background: var(--bg-panel);
  align-items: center;
}

.catalog-controls label {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--fg-2);
}

.catalog-controls label[for=\"catalog-search\"] { grid-area: search-label; }
.catalog-controls label[for=\"catalog-price\"] { grid-area: price-label; }
.catalog-controls label[for=\"catalog-sort\"] { grid-area: sort-label; }
#catalog-search { grid-area: search; }
#catalog-search-help {
  grid-area: search-help;
  font-size: 0.8125rem;
  color: var(--fg-2);
  overflow-wrap: anywhere;
}
#catalog-price { grid-area: price; }
#catalog-sort { grid-area: sort; }

.catalog-controls input,
.catalog-controls select {
  width: 100%;
  min-height: 3rem;
  padding: 0.75rem;
  border: 1px solid var(--fg-2);
  border-radius: var(--radius-md);
  background: var(--bg-field);
  color: var(--fg);
  font: inherit;
  font-size: 0.875rem;
}

.catalog-controls button {
  grid-area: apply;
  min-height: 3rem;
  padding: 0.75rem 1rem;
  border: 1px solid var(--accent);
  border-radius: var(--radius-md);
  background: var(--accent);
  color: var(--bg-base);
  font: inherit;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
}

.catalog-controls > a {
  grid-area: clear;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 3rem;
  font-size: 0.875rem;
  text-decoration: underline;
  text-underline-offset: 0.2em;
}

.results > [role=\"status\"] {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 2rem;
  border: 1px dashed var(--fg-2);
  border-radius: var(--radius-lg);
  background: var(--bg-panel);
}

.results > [role=\"status\"] p { color: var(--fg-2); }

/* A refused query has no shell wrapper in its existing render contract. */
main > .state {
  width: min(var(--shell), calc(100% - 2 * var(--gutter)));
  margin: 2rem auto 4rem;
  padding: 1.5rem;
}

.page > h1 { max-width: 22ch; }

.page > .section {
  padding: 1.5rem;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-lg);
  background: var(--bg-panel);
  gap: 1rem;
}

/* --- cards --- */

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
  gap: var(--space-4);
  list-style: none;
  margin: 0;
  padding: 0;
}

.cards-compact {
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
}

.card {
  display: flex;
  animation: sa-rise var(--motion-base) var(--ease-standard);
}

/*
 * One hover verb for every card: the edge steps up a level, the plate's media scales
 * inside its own clip, and the title underlines. No lift, no shadow, no tint.
 */
html body .card-link {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--bg-panel);
  color: var(--fg);
  text-decoration: none;
  transition: border-color var(--motion-fast) var(--ease-standard);
}

html body .card-link:hover {
  color: var(--fg);
  border-color: var(--line-strong);
}

.card-link:hover .plate-media,
.lead:hover .plate-media {
  transform: scale(1.015);
}

.card-link:hover .card-name,
.lead:hover .lead-title,
.slot-link:hover .slot-title {
  text-decoration-color: currentColor;
}

.card .plate {
  border-bottom: 1px solid var(--line-soft);
}

.card-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4) var(--space-4);
}

.card-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 1.0625rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.3;
  overflow-wrap: anywhere;
  text-decoration-line: underline;
  text-decoration-color: transparent;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.18em;
  transition: text-decoration-color var(--motion-fast) var(--ease-standard);
}

.card-foot {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: auto;
  padding-top: var(--space-3);
  border-top: 1px solid var(--line-soft);
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-1) var(--space-2);
  font-size: 0.8125rem;
  line-height: 1.4;
  color: var(--fg-2);
}

.card-author {
  overflow-wrap: anywhere;
}

.card-share {
  font-size: 0.75rem;
  line-height: 1.5;
  color: var(--fg-2);
}

/*
 * The publish slot: the shelf's last cell, so neither store shows an empty track. It is
 * drawn as an open outline, not a card, because it holds no listing: no plate, no price,
 * no TEST chip, only the route that explains how listing will work.
 */
html body .slot-link {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius-lg);
  color: var(--fg);
  text-decoration: none;
  transition:
    border-color var(--motion-fast) var(--ease-standard),
    background-color var(--motion-fast) var(--ease-standard);
}

html body .slot-link:hover {
  color: var(--fg);
  border-color: var(--fg-2);
  background: var(--bg-row);
}

/* The empty frame where a record's plate would sit: ruled, with nothing drawn on it. */
.slot-plate {
  aspect-ratio: 16 / 10;
  border-bottom: 1px dashed var(--line);
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 24px 24px;
  background-position: center;
}

.slot-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4) var(--space-4);
}

.slot-title {
  display: block;
  font-size: 1.0625rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.3;
  text-decoration-line: underline;
  text-decoration-color: transparent;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.18em;
  transition: text-decoration-color var(--motion-fast) var(--ease-standard);
}

/* An inline-block glyph is outside the title's underline, so only the words underline. */
.slot-title .glyph {
  margin-left: var(--space-2);
}

.slot-text {
  font-size: 0.8125rem;
  line-height: 1.55;
  color: var(--fg-2);
  text-wrap: pretty;
}

.grid-note {
  font-size: 0.8125rem;
  line-height: 1.6;
  color: var(--fg-2);
  max-width: var(--measure);
  text-wrap: pretty;
}

/* --- pricing callout --- */

.pricing {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-8);
  padding: var(--space-6);
  background: var(--bg-panel);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--surface-raised-shadow);
}

.pricing-copy {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.pricing-copy .lede {
  max-width: 46ch;
}

.share {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: var(--space-4);
}

/* The one number the share rule rests on, the loudest thing in the callout. */
.share-figure {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding-left: var(--space-4);
  border-left: 2px solid var(--accent);
}

.share-num {
  font-size: clamp(2.25rem, 1.55rem + 1.95vw, 3.25rem);
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1;
  color: var(--fg);
}

.share-label {
  font-size: 0.8125rem;
  color: var(--fg-2);
}

/* --- named states --- */

/*
 * The quiet register: a neutral panel, a 3px rail in the state's own colour, the title in
 * the text colour, and the reason key as a chip in the tone. The key is the easiest thing
 * in the panel to read and copy, and the panel is never the loudest thing on its page.
 */
.state {
  --tone: var(--fg-2);
  --tone-bg: var(--bg-row);
  --tone-line: var(--line);
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-4) var(--space-4) var(--space-6);
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--bg-panel);
}

.state::before {
  content: \"\";
  position: absolute;
  inset: 0 auto 0 0;
  width: 3px;
  background: var(--tone);
}

.state-warn {
  --tone: var(--status-needs-review-fg);
  --tone-bg: var(--status-needs-review-bg);
  --tone-line: var(--status-needs-review-line);
}

.state-deny {
  --tone: var(--danger);
  --tone-bg: var(--status-refused-bg);
  --tone-line: var(--status-refused-line);
}

.state-ok {
  --tone: var(--ok);
  --tone-bg: var(--status-validated-bg);
  --tone-line: var(--status-validated-line);
}

.state-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2) var(--space-3);
}

.state h3 {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--fg);
}

.state p {
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--fg-2);
  max-width: var(--measure);
  text-wrap: pretty;
}

/* The reason key, as a chip on the chip system's 11px mono step, in the state's tone. */
.state .reason {
  display: inline-flex;
  align-items: center;
  min-height: 1.375rem;
  padding: 0 6px;
  border: 1px solid var(--tone-line);
  border-radius: var(--radius-sm);
  background: var(--tone-bg);
  font-size: var(--micro);
  letter-spacing: 0.02em;
  color: var(--tone);
  overflow-wrap: anywhere;
}

/* --- footer --- */

.footer {
  border-top: 1px solid var(--line-soft);
  background: var(--bg-field);
}

.footer-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-8);
  align-items: start;
  padding-top: var(--section-pad);
  padding-bottom: var(--space-8);
}

.footer-brand {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  max-width: 36ch;
}

.footer-brand-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  font-size: 1.0625rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.footer-glyph {
  width: 20px;
  height: 20px;
  border-radius: var(--mark-radius);
  background: var(--accent);
  display: grid;
  place-items: center;
  flex: none;
}

.footer-glyph::after {
  content: \"\";
  width: 8px;
  height: 8px;
  border: 2px solid var(--bg-base);
  border-radius: var(--mark-radius);
}

.footer-blurb,
.footer-note {
  font-size: 0.8125rem;
  line-height: 1.6;
  color: var(--fg-2);
  text-wrap: pretty;
}

.footer-cols {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-6);
}

.footer-col {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.footer-col ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
}

html body .footer-col a,
.footer-col li > span {
  display: block;
  padding: 10px 0;
  font-size: 0.875rem;
  line-height: 1.45;
  color: var(--fg-2);
}

.footer-col .glyph {
  margin-left: var(--space-1);
}

html body .footer-col a {
  text-decoration-color: transparent;
}

html body .footer-col a:hover {
  color: var(--fg);
  text-decoration-color: currentColor;
}

.footer-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-6);
  background: var(--bg-panel);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
}

.footer-card-title {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--fg);
}

.footer-base {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  border-top: 1px solid var(--line-soft);
  padding-top: var(--space-6);
  padding-bottom: var(--space-8);
  font-size: 0.8125rem;
  color: var(--fg-2);
}

/* --- detail --- */

.detail {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  padding-top: var(--space-6);
  padding-bottom: var(--section-pad);
}

.crumbs {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2);
  font-size: 0.8125rem;
  line-height: 1.4;
  color: var(--fg-2);
}

html body .crumbs a {
  color: var(--fg-2);
  text-decoration-color: transparent;
}

html body .crumbs a:hover {
  color: var(--fg);
  text-decoration-color: currentColor;
}

.crumbs [aria-current=\"page\"] {
  color: var(--fg);
}

.detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-8);
  align-items: start;
}

.detail-main {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}

.detail-side {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  scrollbar-width: thin;
  scrollbar-color: var(--line-strong) transparent;
}

.detail-figure {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin: 0;
}

/*
 * The detail page's section headings sit a step under the 42px title, so the title keeps
 * its 1.4 lead over them; the mono labels inside the buy column are not section headings.
 */
.detail .section-head h2 {
  font-size: 1.75rem;
}

.buy {
  background: var(--bg-panel);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.buy-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-4);
}

.buy-title {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

/* Detail title and price share the 42px display step: the title leads the column. */
.buy h1 {
  font-size: clamp(2rem, 1.55rem + 1.3vw, 2.625rem);
  line-height: 1.04;
  letter-spacing: -0.02em;
}

.buy-by {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2);
  font-size: 0.875rem;
  color: var(--fg-2);
}

.creator-chip {
  display: inline-flex;
  align-items: center;
  min-height: 1.5rem;
  padding: 0 var(--space-2);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--bg-raised);
  font-family: var(--store-mono);
  font-size: 0.75rem;
  color: var(--fg);
  overflow-wrap: anywhere;
}

.buy-price {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--space-2);
}

.buy-price-num {
  font-size: clamp(2rem, 1.55rem + 1.3vw, 2.625rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1;
  overflow-wrap: anywhere;
}

.buy-price-unit {
  font-size: 0.875rem;
  color: var(--fg-2);
}

.buy-block {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.buy-options {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: var(--space-2);
  list-style: none;
  margin: 0;
  padding: 0;
}

.buy-option {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 6px 10px;
  background: var(--bg-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
}

.buy-option-name {
  font-size: 0.75rem;
  line-height: 1.4;
  color: var(--fg-2);
}

.buy-option-value {
  font-family: var(--store-mono);
  font-size: 0.8125rem;
  line-height: 1.45;
  color: var(--fg);
  overflow-wrap: anywhere;
}

.buy-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.buy-actions .note {
  line-height: 1.5;
}

/*
 * The inert purchase notice sits in the slot a cart button would take, directly under the
 * one working action, inset a level so it reads as a slot rather than an alarm.
 */
.buy .state {
  gap: var(--space-2);
  background: var(--bg-field);
  padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
}

.buy .state p {
  font-size: 0.8125rem;
  line-height: 1.45;
}

/*
 * The four labelled facts as a two-column grid of label-value pairs, so the two short
 * ones share a row and the long viewer and registry lines take their own.
 */
.notice-facts {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: var(--space-1) var(--space-3);
  margin: 0;
  padding-top: var(--space-2);
  border-top: 1px solid var(--line-soft);
  font-family: var(--store-mono);
  font-size: 0.75rem;
  line-height: 1.45;
}

.notice-fact {
  display: flex;
  flex-wrap: wrap;
  column-gap: 6px;
}

.notice-fact-wide {
  grid-column: 1 / -1;
}

.notice-facts dt {
  color: var(--fg-2);
}

.notice-facts dd {
  margin: 0;
  color: var(--fg);
  overflow-wrap: anywhere;
}

.buy-spec {
  display: grid;
  grid-template-columns: max-content minmax(0, 1fr);
  gap: var(--space-1) var(--space-4);
  margin: 0;
  padding: 10px var(--space-4);
  border-top: 1px solid var(--line-soft);
  background: var(--bg-field);
}

.buy-spec dt {
  font-size: 0.8125rem;
  line-height: 1.45;
  color: var(--fg-2);
}

.buy-spec dd {
  margin: 0;
  font-family: var(--store-mono);
  font-size: 0.75rem;
  line-height: 1.55;
  color: var(--fg);
  text-align: right;
  overflow-wrap: anywhere;
}

/* --- the fixture listing record --- */

.included {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-2);
  list-style: none;
  margin: 0;
  padding: 0;
}

/*
 * A spec sheet row: the key in the secondary level and the value, a contract string, in
 * mono under it, so a package id or a timestamp never competes with its label for width.
 */
.included-row {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: baseline;
  column-gap: var(--space-3);
  row-gap: 2px;
  padding: var(--space-3);
  background: var(--bg-panel);
  border: 1px solid var(--line-soft);
  border-radius: var(--radius-md);
}

.included-check {
  grid-row: span 2;
  align-self: start;
  width: 16px;
  height: 16px;
  border-radius: var(--radius-sm);
  background: var(--status-validated-bg);
  border: 1px solid var(--status-validated-line);
  color: var(--ok);
  display: grid;
  place-items: center;
  font-size: 0.6875rem;
  font-weight: 700;
  line-height: 1;
}

.included-key {
  font-size: 0.8125rem;
  line-height: 1.4;
  color: var(--fg-2);
}

.included-value {
  font-family: var(--store-mono);
  font-size: 0.75rem;
  line-height: 1.5;
  color: var(--fg);
  overflow-wrap: anywhere;
}

/* --- publish --- */

.publish-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-8);
  align-items: start;
  padding-top: var(--section-pad);
  padding-bottom: var(--section-pad);
}

.publish-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-6);
}

.publish-copy h1 {
  max-width: 16ch;
}

.publish-band {
  padding-bottom: var(--section-pad);
}

.publish-flow {
  display: flex;
  flex-direction: column;
  gap: var(--section-pad);
  padding-bottom: var(--section-pad);
}

/* The earnings callout: three derived figures, and the creator's is the lead. */
.earn {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-6);
  background: var(--bg-panel);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--surface-raised-shadow);
}

.earn-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin: 0;
}

.earn-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding-left: var(--space-4);
  border-left: 2px solid var(--line);
}

.earn-row dt {
  font-family: var(--store-mono);
  font-size: var(--micro);
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--fg-2);
}

.earn-row dd {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  margin: 0;
}

.earn-num {
  font-size: clamp(2rem, 1.55rem + 1.3vw, 2.625rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1;
  color: var(--fg-2);
}

.earn-unit {
  font-size: 0.875rem;
  color: var(--fg-2);
}

.earn-lead {
  border-left-color: var(--accent);
}

/* Feedback is interaction-driven, never an ambient pulse. */
@media (prefers-reduced-motion: no-preference) {
  .button,
  .catalog-controls button,
  .card-link .plate {
    transition: border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard);
  }

  .button:active:not([aria-disabled=\"true\"]),
  .catalog-controls button:active { transform: translateY(1px); }
}

/* At 390px the controls use the full-width base layout. Only regroup once
 * two readable selects fit; keyboard order remains search, price, sort, apply. */
@media (min-width: 30rem) {
  .catalog-controls {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      \"search-label search-label\"
      \"search search\"
      \"search-help search-help\"
      \"price-label sort-label\"
      \"price sort\"
      \"apply clear\";
  }

  .card-head { flex-direction: row; align-items: baseline; }
}

@media (min-width: 48rem) {
  .catalog-controls {
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      \"search-label price-label sort-label\"
      \"search price sort\"
      \"search-help search-help search-help\"
      \"apply clear .\";
  }

  .catalog-controls button,
  .catalog-controls > a { justify-self: start; }
}

/* --- footer --- */

.earn-lead .earn-num {
  color: var(--fg);
}

/* Numbered requirement rows, drawn as one path: the ordinal comes from the list itself. */
.req-list {
  counter-reset: req;
  position: relative;
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
}

/* The line that joins the requirements, running behind their ordinals. */
.req-list::before {
  content: \"\";
  position: absolute;
  left: calc(1rem - 0.5px);
  top: 1.75rem;
  bottom: 1.75rem;
  width: 1px;
  background: var(--line-strong);
}

.req-row {
  counter-increment: req;
  position: relative;
  display: grid;
  grid-template-columns: 2rem minmax(0, 1fr);
  align-items: center;
  column-gap: var(--space-4);
  min-height: 3.5rem;
  padding: var(--space-2) 0;
  font-size: 0.9375rem;
  line-height: 1.5;
  color: var(--fg);
}

.req-row::before {
  content: counter(req, decimal-leading-zero) / \"\";
  display: grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-full);
  background: var(--bg-raised);
  font-family: var(--store-mono);
  font-size: var(--micro);
  font-weight: 500;
  color: var(--fg);
  position: relative;
  z-index: 1;
}

/* The TEST pipeline as step cards, intake → screening → curation → listed. */
.flow {
  counter-reset: flow;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-4);
  list-style: none;
  margin: 0;
  padding: 0;
}

.flow-step {
  counter-increment: flow;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-4);
  background: var(--bg-panel);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
}

.flow-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.flow-num::before {
  content: \"Step \" counter(flow, decimal-leading-zero) / \"\";
}

.flow-num {
  display: inline-flex;
  align-items: center;
  min-height: 1.5rem;
  padding: 0 var(--space-2);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-full);
  background: var(--bg-raised);
  font-family: var(--store-mono);
  font-size: var(--micro);
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--fg);
}

.flow-state {
  font-size: 0.9375rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--fg);
}

.flow-note {
  font-size: 0.8125rem;
  line-height: 1.55;
  color: var(--fg-2);
  text-wrap: pretty;
}

.flow-at {
  margin-top: auto;
  font-family: var(--store-mono);
  font-size: 0.75rem;
  letter-spacing: 0.02em;
  color: var(--fg-2);
  overflow-wrap: anywhere;
}

.dl {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-1) var(--space-6);
  margin: 0;
  font-size: 0.875rem;
}

.dl dt {
  font-family: var(--store-mono);
  font-size: var(--micro);
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--fg-2);
}

.dl dd {
  margin: 0 0 var(--space-3);
  color: var(--fg);
  overflow-wrap: anywhere;
}

.dl code {
  font-size: 0.75rem;
}

/*
 * --- responsive ---
 *
 * Every multi-column layout is declared single-column above and widened here. 36rem puts
 * the masthead on one row, tablet (48rem) splits the hero, the facts and the detail page,
 * and desktop (64rem) adds the browse rail, the sticky panels and the 72px band rhythm.
 * Nothing below is a narrowing override, so a viewport under a breakpoint always gets the
 * simpler layout rather than a squashed one.
 */

@media (min-width: 36rem) {
  .family-inner {
    gap: var(--space-4);
    min-height: 2.1875rem;
    mask-image: none;
  }

  /* From 36rem there is room to set the family name off from the three surfaces. */
  .family-brand {
    padding-right: var(--space-4);
    border-right: 1px solid var(--line);
  }

  .family-list {
    gap: var(--space-4);
  }

  /* One 64px row, hairline included, well inside the 88px the anchor offset clears. */
  .masthead-inner {
    column-gap: var(--space-4);
    flex-wrap: nowrap;
    min-height: 63px;
    padding-top: 0;
  }

  .nav {
    flex: 0 1 auto;
    margin-left: auto;
    margin-right: -10px;
  }

  html body .nav a {
    min-height: 2.25rem;
  }

  .hero-actions {
    width: auto;
  }

  .hero-actions .button:first-child {
    flex: 0 0 auto;
  }

  .footer-cols {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
  }

  .footer-base {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
  }
}

@media (min-width: 48rem) {
  /* The domain line joins the family bar once it and the three surfaces share a row. */
  .family-domain {
    display: block;
  }

  .masthead-inner {
    column-gap: var(--space-6);
  }

  .hero-inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
  }

  .hero-copy {
    gap: var(--space-6);
  }

  .browse,
  .results {
    gap: var(--space-6);
  }

  .results-head {
    padding-bottom: var(--space-4);
  }

  .lead-caption {
    padding: var(--space-3) var(--space-4);
  }

  .facts-list {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
  }

  .facts-list .fact {
    order: 0;
    padding: var(--space-4) var(--space-6);
    border-top: 0;
  }

  .facts-list .fact:first-child {
    padding-left: 0;
  }

  .fact + .fact {
    border-left: 1px solid var(--line-soft);
  }

  .cards {
    gap: var(--grid-gap);
  }

  .pricing {
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    padding: var(--space-8);
  }

  .detail-grid {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  }

  /*
   * Source order is title-and-price first, which is the order a small screen wants and
   * the order a screen reader wants. Desktop puts that column back on the right.
   */
  .detail-side {
    order: 2;
  }

  .detail-main {
    order: 1;
  }

  .included {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .dl {
    grid-template-columns: minmax(10rem, max-content) minmax(0, 1fr);
  }

  .dl dd {
    margin-bottom: 0;
  }

  .flow {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .footer-cols {
    gap: var(--space-8);
  }

  html body .footer-col a,
  .footer-col li > span {
    padding: 6px 0;
  }
}

@media (min-width: 64rem) {
  :root {
    --section-pad: var(--space-18);
  }

  .hero {
    --spot-at: 76% 50%;
  }

  .hero-inner {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px;
  }

  .browse {
    grid-template-columns: 216px minmax(0, 1fr);
    gap: var(--space-8);
  }

  /*
   * Both columns pin below the masthead, and both are bounded by the space that leaves.
   * A sticky box taller than its scrollport stops moving once its top reaches the offset,
   * so everything past the bottom edge would be unreachable at any short desktop height —
   * on the detail page that is the end of the purchase notice and the record, and the
   * refused state adds a panel above them. Bounding the column and letting it scroll
   * inside itself keeps the archive's sticky intent without hiding its own tail.
   * `tabindex` is what makes that inner scroll reachable from the keyboard: neither
   * column ends in a focusable element, so tabbing through the page alone would never
   * bring the bottom into view.
   */
  .rail {
    flex-direction: column;
    /*
     * Back to a stretched column: the phone rail is a scrolling row of fixed-width cards,
     * and in a column flex container a fixed basis would size every group to its own
