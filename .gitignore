node_modules/
dist/
dist-sdk/
dist-sdk-again/
build/
.turbo/
.cache/
coverage/
*.log
.DS_Store
.idea/
.vscode/
*.tsbuildinfo

# Local project state, including the evidence a gate run regenerates. The few
# committed evidence files under `.sceneaxi/evidence/` are already tracked and
# stay tracked; adding another one is a deliberate `git add -f`.
.sceneaxi/

# sites/ are separate install roots (see docs/websites-deploy.md)
sites/*/.next/
sites/*/public/engine-sdk/
sites/*/node_modules/
sites/*/next-env.d.ts
sites/*/test-results/
sites/*/playwright-report/

# desktop/ apps are separate install roots too (ADR 0024); `release/` holds the
# packaged AppImage/deb artifacts and their SHA256SUMS, `dist-build/` is a
# transient bundle step. `dist/` and `node_modules/` are already ignored above.
desktop/*/release/
desktop/*/dist-build/

# Vercel CLI link state, at any depth (covers sites/*/.vercel/).
.vercel/

# Env files at any depth, including each site's: `.env`, `.env.local`, and
# direnv's `.envrc`/`.envrc.local`, which export secrets just as readily.
# `.env.example` files are committed name-only templates and must stay tracked,
# so nothing below may re-ignore them: the last matching pattern wins in git,
# and a second `.env*` after this negation would silently defeat it.
.env*
!.env.example
