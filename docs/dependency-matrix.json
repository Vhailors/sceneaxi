{
  "schemaVersion": 1,
  "authoredFor": "sceneaxi bootstrap seed (post-FAIL remediations, 2026-07-21)",
  "rule": "packages depend downward only; allow lists are exhaustive — any internal dependency or source import not listed here is a violation",
  "packages": {
    "@sceneaxi/schemas": {
      "dir": "packages/schemas",
      "releaseGroup": "contracts",
      "allow": []
    },
    "@sceneaxi/engine-kernel": {
      "dir": "packages/engine-kernel",
      "releaseGroup": "core-train",
      "allow": ["@sceneaxi/schemas"]
    },
    "@sceneaxi/engine-presentation": {
      "dir": "packages/engine-presentation",
      "releaseGroup": "core-train",
      "allow": ["@sceneaxi/schemas", "@sceneaxi/engine-kernel"]
    },
    "@sceneaxi/engine-orchestrator": {
      "dir": "packages/engine-orchestrator",
      "releaseGroup": "core-train",
      "allow": ["@sceneaxi/schemas", "@sceneaxi/engine-kernel"]
    },
    "@sceneaxi/authoring-core": {
      "dir": "packages/authoring-core",
      "releaseGroup": "core-train",
      "allow": [
        "@sceneaxi/schemas",
        "@sceneaxi/engine-kernel",
        "@sceneaxi/engine-presentation",
        "@sceneaxi/engine-orchestrator"
      ]
    },
    "@sceneaxi/profile-game": {
      "dir": "packages/profile-game",
      "releaseGroup": "profile",
      "allow": [
        "@sceneaxi/schemas",
        "@sceneaxi/authoring-core",
        "@sceneaxi/engine-kernel",
        "@sceneaxi/engine-presentation",
        "@sceneaxi/engine-orchestrator"
      ]
    },
    "@sceneaxi/profile-web": {
      "dir": "packages/profile-web",
      "releaseGroup": "profile",
      "allow": [
        "@sceneaxi/schemas",
        "@sceneaxi/authoring-core",
        "@sceneaxi/engine-kernel",
        "@sceneaxi/engine-presentation",
        "@sceneaxi/engine-orchestrator"
      ]
    },
    "@sceneaxi/profile-kids": {
      "dir": "packages/profile-kids",
      "releaseGroup": "profile",
      "allow": [
        "@sceneaxi/schemas",
        "@sceneaxi/authoring-core",
        "@sceneaxi/engine-kernel",
        "@sceneaxi/engine-presentation",
        "@sceneaxi/engine-orchestrator"
      ]
    },
    "@sceneaxi/cli": {
      "dir": "packages/cli",
      "releaseGroup": "cli-protocol",
      "allow": ["@sceneaxi/schemas", "@sceneaxi/authoring-core"]
    },
    "@sceneaxi/importers": {
      "dir": "packages/importers",
      "releaseGroup": "importers",
      "allow": ["@sceneaxi/schemas", "@sceneaxi/authoring-core"]
    },
    "@sceneaxi/provider-openrouter": {
      "dir": "packages/provider-openrouter",
      "releaseGroup": "importers",
      "allow": ["@sceneaxi/schemas", "@sceneaxi/authoring-core"]
    },
    "@sceneaxi/plugin-host": {
      "dir": "packages/plugin-host",
      "releaseGroup": "plugin-host",
      "allow": ["@sceneaxi/schemas"]
    },
    "@sceneaxi/auth": {
      "dir": "packages/auth",
      "releaseGroup": "identity",
      "allow": ["@sceneaxi/schemas"]
    },
    "@sceneaxi/billing": {
      "dir": "packages/billing",
      "releaseGroup": "identity",
      "allow": ["@sceneaxi/schemas", "@sceneaxi/auth"]
    },
    "@sceneaxi/web-shell": {
      "dir": "apps/web-shell",
      "releaseGroup": "apps",
      "allow": [
        "@sceneaxi/schemas",
        "@sceneaxi/authoring-core",
        "@sceneaxi/auth",
        "@sceneaxi/billing"
      ]
    },
    "@sceneaxi/desktop-shell": {
      "dir": "apps/desktop-shell",
      "releaseGroup": "apps",
      "allow": ["@sceneaxi/schemas", "@sceneaxi/authoring-core"]
    },
    "@sceneaxi/catalog-game": {
      "dir": "apps/catalog-game",
      "releaseGroup": "apps",
      "allow": ["@sceneaxi/schemas"]
    },
    "@sceneaxi/catalog-web": {
      "dir": "apps/catalog-web",
      "releaseGroup": "apps",
      "allow": ["@sceneaxi/schemas"]
    },
    "@sceneaxi/site-kit": {
      "dir": "packages/site-kit",
      "releaseGroup": "sites",
      "allow": ["@sceneaxi/schemas", "@sceneaxi/authoring-core"]
    },
    "@sceneaxi/site-umbrella": {
      "dir": "sites/umbrella",
      "releaseGroup": "sites",
      "allow": ["@sceneaxi/site-kit"]
    },
    "@sceneaxi/site-catalog-game": {
      "dir": "sites/catalog-game",
      "releaseGroup": "sites",
      "allow": ["@sceneaxi/site-kit"]
    },
    "@sceneaxi/site-catalog-web": {
      "dir": "sites/catalog-web",
      "releaseGroup": "sites",
      "allow": ["@sceneaxi/site-kit"]
    }
  },
  "kidsBoundary": {
    "kidsPackages": ["@sceneaxi/profile-kids"],
    "allowedDependents": [],
    "rule": "no package or app may depend on or import a Kids package; allowedDependents remains empty under the locked Kids isolation boundary"
  },
  "delayed": {
    "@sceneaxi/engine-asset-compiler": {
      "releaseGroup": "core-train",
      "allow": ["@sceneaxi/schemas", "@sceneaxi/engine-kernel"],
      "arrives": "with the proof program's landings (spec #41)"
    },
    "@sceneaxi/engine-platform-host": {
      "releaseGroup": "core-train",
      "allow": ["@sceneaxi/schemas", "@sceneaxi/engine-kernel", "@sceneaxi/engine-presentation"],
      "arrives": "with the proof program's landings (spec #41)"
    },
    "@sceneaxi/engine-evidence": {
      "releaseGroup": "core-train",
      "allow": ["@sceneaxi/schemas"],
      "arrives": "with the proof program's landings (spec #41)"
    },
    "@sceneaxi/provider-<name>": {
      "releaseGroup": "importers",
      "allow": ["@sceneaxi/schemas", "@sceneaxi/authoring-core"],
      "arrives": "additional provider adapters behind the Model Provider Port under the locked llm-provider-policy; ordinary ticketed work only"
    }
  },
  "releaseGroups": {
    "contracts": { "policy": "schemas carry their own versions; the package root stays browser-safe while Node-only executable suites use explicit node subpaths; every consumer refuses major mismatches" },
    "core-train": { "policy": "one shared semver train — a 'core release' covers all engine packages and authoring-core" },
    "profile": { "policy": "independently versioned; each profile MUST declare sceneaxi.corePin (a semver range on the core train)" },
    "cli-protocol": { "policy": "versions with its protocol envelope; output-schema changes are semver events" },
    "importers": { "policy": "independently versioned" },
    "plugin-host": {
      "policy": "independently versioned; consumes only public contracts from schemas; never engine packages or service locators"
    },
    "identity": {
      "policy": "independently versioned; the identity/credits/billing plane consumes only public contracts from schemas (and, for billing, the auth seam); never engine packages, profiles, the CLI, or a service locator. Better Auth, Neon, and the Stripe API stay injected adapters (ADR 0021)."
    },
    "apps": { "policy": "private, unpublished, unversioned beyond workspace bookkeeping" },
    "sites": {
      "policy": "first-party deployable web surfaces and their shared deployment-neutral logic; consume only public contracts and public authoring-core APIs; never engine packages, profiles, a service locator, or Kids; framework and provider SDKs stay in the sites/ tier and out of the hermetic package tier"
    }
  }
}
